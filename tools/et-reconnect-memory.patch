 #include <cstdint>

 namespace et {
+namespace {
+// CatchupBuffer is repeated bytes field 1. Stream its protobuf encoding rather
+// than materializing vector<string>, CatchupBuffer and a serialized copy at
+// once.
+size_t varintSize(uint64_t value) {
+  size_t size = 1;
+  while (value >= 128) {
+    value >>= 7;
+    ++size;
+  }
+  return size;
+}
+
+class RecoveryOutput {
+ public:
+  RecoveryOutput(SocketHandler& handler, int fd) : handler(handler), fd(fd) {}
+
+  void append(const char* data, size_t size) {
+    while (size > 0) {
+      size_t take = std::min(size, buffer.size() - used);
+      memcpy(buffer.data() + used, data, take);
+      used += take;
+      data += take;
+      size -= take;
+      if (used == buffer.size()) flush();
+    }
+  }
+
+  void appendPacketLength(uint64_t length) {
+    char header[11];
+    size_t size = 0;
+    header[size++] = '\x0a';  // field 1, length-delimited
+    while (length >= 128) {
+      header[size++] = char((length & 127) | 128);
+      length >>= 7;
+    }
+    header[size++] = char(length);
+    append(header, size);
+  }
+
+  void flush() {
+    if (used == 0) return;
+    handler.writeAllOrThrow(fd, buffer.data(), used, true);
+    used = 0;
+  }
+
+ private:
+  SocketHandler& handler;
+  int fd;
+  std::array<char, 64 * 1024> buffer;
+  size_t used = 0;
+};
+}  // namespace
