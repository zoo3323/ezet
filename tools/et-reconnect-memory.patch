--- a/test/unit_tests/ClientConnectionTest.cpp
+++ b/test/unit_tests/ClientConnectionTest.cpp
@@ -95,6 +95,82 @@ class RecoverableConnection : public Connection {

   void closeSocketAndMaybeReconnect() override { closeSocket(); }
