+TEST_CASE("filterTmuxCc keeps mid-line lines up to a message boundary",
+          "[TmuxCcFilter]") {
+  const string rest =
+      "end of a cut line\n"
+      "next tty line\n"
+      "%layout-change @1 vis\n"
+      "%output %0 x\n"
+      "trailing";
+  TmuxCcFilterResult result = filterTmuxCc(rest, true);
+  REQUIRE(result.kept ==
+          "end of a cut line\n"
+          "next tty line\n"
+          "%layout-change @1 vis\n");
+  REQUIRE(result.droppable == "%output %0 x\ntrailing");
+  REQUIRE(result.dropped == result.droppable.size());
+  REQUIRE_FALSE(result.skipUntilNewline);
+}
+
+// Plain TTY output is misread as control mode once any line starts with '%'.
+// A disconnected client lets megabytes of it pile up, and the filter used to
+// recurse once per line on a fresh copy of the remainder: memory grew with the
+// square of the line count and the server hit its memory limit. This input
+// needs hundreds of GB that way; walking it in place stays linear.
+TEST_CASE("filterTmuxCc stays linear on a large mid-line TTY backlog",
+          "[TmuxCcFilter]") {
+  string tty;
+  for (int i = 0; i < 200000; ++i) {
+    tty += "building step " + std::to_string(i) + " 47%\r\n";
+  }
+  TmuxCcFilterResult kept = filterTmuxCc(tty, true, false);
+  REQUIRE(kept.kept == tty);
+  REQUIRE(kept.dropped == 0);
+
+  string control = "cut\n";
+  for (int i = 0; i < 200000; ++i) {
+    control += "%output %0 line\n";
+  }
+  TmuxCcFilterResult dropped = filterTmuxCc(control, true);
+  REQUIRE(dropped.kept == "cut\n");
+  REQUIRE(dropped.dropped == control.size() - 4);
+}
