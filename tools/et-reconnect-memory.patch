+
+// Script the peer's sequence/catchup response while recording the real
+// Connection::recover write path. Large writes expose a whole-backlog copy.
+class ReplayOrderClient : public ClientConnection {
+ public:
+  ReplayOrderClient(shared_ptr<SocketHandler> sh, int fd, const string& key)
+      : ClientConnection(sh, SocketEndpoint(), "replay-order", key) {
+    socketFd = fd;
+    reader =
+        make_shared<BackedReader>(sh, make_shared<CryptoHandler>(key, 0), fd);
+    writer =
+        make_shared<BackedWriter>(sh, make_shared<CryptoHandler>(key, 0), fd);
+  }
+  bool recoverPublic(int fd) { return recover(fd); }
+};
+
+class RecoveryStreamHandler : public SocketHandler {
+ public:
+  string incoming;
+  string outgoing;
+  size_t position = 0;
+  size_t largestWrite = 0;
+  bool recording = false;
+
+  bool hasData(int) override { return position < incoming.size(); }
+  ssize_t read(int, void* buf, size_t count) override {
+    size_t n = std::min(count, incoming.size() - position);
+    memcpy(buf, incoming.data() + position, n);
+    position += n;
+    return n;
+  }
+  ssize_t write(int, const void* buf, size_t count) override {
+    if (!recording) return count;
+    largestWrite = std::max(largestWrite, count);
+    // Also exercise partial writes without needing a slow OS socket.
+    size_t n = std::min(count, size_t(1024));
+    outgoing.append(static_cast<const char*>(buf), n);
+    return n;
+  }
+  int connect(const SocketEndpoint&) override { return -1; }
+  set<int> listen(const SocketEndpoint&) override { return {}; }
+  set<int> getEndpointFds(const SocketEndpoint&) override { return {}; }
+  int accept(int) override { return -1; }
+  void stopListening(const SocketEndpoint&) override {}
+  void close(int) override {}
+  vector<int> getActiveSockets() override { return {}; }
+
+  template <typename T>
+  void enqueueProto(const T& proto) {
+    string bytes = proto.SerializeAsString();
+    int64_t length = bytes.size();
+    incoming.append(reinterpret_cast<const char*>(&length), sizeof(length));
+    incoming += bytes;
+  }
+};
+
+class FragmentedRecoveryHandler : public RecoveryStreamHandler {
+ public:
+  string liveBytes;
+  size_t livePosition = 0;
+  size_t liveAvailable = 12;
+  size_t lastLiveRead = 0;
+
+  ssize_t read(int fd, void* buf, size_t count) override {
+    if (fd != 10) return RecoveryStreamHandler::read(fd, buf, count);
+    lastLiveRead = count;
+    if (livePosition == liveAvailable) {
+      SetErrno(EAGAIN);
+      return -1;
+    }
+    size_t n = std::min(count, liveAvailable - livePosition);
+    memcpy(buf, liveBytes.data() + livePosition, n);
+    livePosition += n;
+    return n;
+  }
+};
