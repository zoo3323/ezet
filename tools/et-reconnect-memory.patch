+TEST_CASE("Connection recovery streams a backlog in bounded writes",
+          "[Connection][RecoveryMemory]") {
+  auto handler = make_shared<RecoveryStreamHandler>();
+  const string key = "12345678901234567890123456789012";
+  auto writer = make_shared<BackedWriter>(
+      handler, make_shared<CryptoHandler>(key, 0), 10);
+  auto reader = make_shared<BackedReader>(
+      handler, make_shared<CryptoHandler>(key, 0), 10);
+  RecoverableConnection conn(handler, reader, writer, 10, key);
+  const string payload(1024 * 1024, 'x');
+  for (int i = 0; i < 3; ++i) conn.write(Packet(i, payload));
+  conn.closeSocket();
+
+  SequenceHeader peerSequence;
+  peerSequence.set_sequencenumber(0);
+  handler->enqueueProto(peerSequence);
+  handler->enqueueProto(CatchupBuffer());
+  handler->recording = true;
+  CHECK(conn.recoverPublic(20));
+  CHECK(handler->largestWrite <= 64 * 1024);
+
+  // Decode using the existing protobuf reader: the wire format must remain
+  // compatible with old clients, including packet order and encryption.
+  handler->incoming = std::move(handler->outgoing);
+  handler->position = 0;
+  auto sequence = handler->readProto<SequenceHeader>(20, true);
+  CHECK(sequence.sequencenumber() == 0);
+  auto catchup = handler->readProto<CatchupBuffer>(20, true);
+  REQUIRE(catchup.buffer_size() == 3);
+  auto decrypt = make_shared<CryptoHandler>(key, 0);
+  for (int i = 0; i < catchup.buffer_size(); ++i) {
+    Packet packet(catchup.buffer(i));
+    packet.decrypt(decrypt);
+    CHECK(packet.getHeader() == i);
+    CHECK(packet.getPayload() == payload);
+  }
+  CHECK(handler->position == handler->incoming.size());
+  conn.shutdown();
+}
+
+TEST_CASE("Failed recovery preserves a partially read live packet",
+          "[ClientConnection][RecoveryMemory]") {
+  auto handler = make_shared<FragmentedRecoveryHandler>();
+  const string key = "12345678901234567890123456789012";
+  ServerClientConnection conn(handler, "fragmented", 10, key);
+  Packet sent(1, string(1024, 'x'));
+  sent.encrypt(make_shared<CryptoHandler>(key, CLIENT_SERVER_NONCE_MSB));
+  string bytes = sent.serialize();
+  uint32_t size = htonl(bytes.size());
+  handler->liveBytes.assign(reinterpret_cast<const char*>(&size), sizeof(size));
+  handler->liveBytes += bytes;
+  Packet received;
+  REQUIRE_FALSE(conn.readPacket(&received));
+  REQUIRE(conn.getSocketFd() == 10);
+
+  SequenceHeader invalidSequence;
+  invalidSequence.set_sequencenumber(1);  // Ahead of this server's writer.
+  handler->enqueueProto(invalidSequence);
+  CHECK_FALSE(conn.recoverClient(20));
+  CHECK(conn.getSocketFd() == 10);
+
+  // Keep the peer paused, so a broken implementation cannot interpret random
+  // encrypted body bytes as a huge length and allocate gigabytes in this test.
+  CHECK(conn.getReader()->read(&received) == -1);
+  size_t remaining = bytes.size() - 8;
+  CHECK(handler->lastLiveRead == remaining);
+  if (handler->lastLiveRead == remaining) {
+    handler->liveAvailable = handler->liveBytes.size();
+    CHECK(conn.readPacket(&received));
+    CHECK(received.getPayload() == string(1024, 'x'));
+  }
+  conn.shutdown();
+}
+
+TEST_CASE("Client recovery drains peer catchup before sending its own",
+          "[Connection]") {
+  auto handler = make_shared<SocketPairHandler>();
+  int live[2];
+  REQUIRE(createTestSocketPair(live) == 0);
+
+  const string key = "zyxwvutsrqponmlkjihgfedcba987654";
+  ReplayOrderClient conn(handler, live[0], key);
+
+  conn.write(Packet(1, "first"));
+  conn.write(Packet(2, "second"));
+  conn.closeSocket();
+
+  int reconnect[2];
+  REQUIRE(createTestSocketPair(reconnect) == 0);
+
+  // The peer follows the server's order: it sends its catchup, then reads. It
+  // only records what it sees; the assertions run on the test thread.
+  int64_t peerSawSequence = -1;
+  bool catchupArrivedEarly = true;
+  int peerCatchupSize = -1;
+  std::exception_ptr peerError;
+  std::thread remote([&]() {
+    try {
+      auto seqHeader = handler->readProto<SequenceHeader>(reconnect[1], true);
+      peerSawSequence = seqHeader.sequencenumber();
+
+      SequenceHeader seqResponse;
+      seqResponse.set_sequencenumber(1);
+      handler->writeProto(reconnect[1], seqResponse, true);
+
+      // A connection that reads first sends nothing until our catchup
+      // arrives. A connection that sends first writes its small catchup as
+      // soon as it has our header, well inside this window.
+      std::this_thread::sleep_for(std::chrono::milliseconds(200));
+      catchupArrivedEarly = handler->hasData(reconnect[1]);
+
+      CatchupBuffer back;
+      handler->writeProto(reconnect[1], back, true);
+      auto catchup = handler->readProto<CatchupBuffer>(reconnect[1], true);
+      peerCatchupSize = catchup.buffer_size();
+    } catch (...) {
+      peerError = std::current_exception();
+    }
+    handler->close(reconnect[1]);
+  });
+
+  bool recovered = conn.recoverPublic(reconnect[0]);
+  remote.join();
+  conn.shutdown();
+  handler->close(live[1]);
+  if (peerError) {
+    std::rethrow_exception(peerError);
+  }
+  REQUIRE(recovered);
+  REQUIRE(peerSawSequence == 0);
+  REQUIRE_FALSE(catchupArrivedEarly);
+  REQUIRE(peerCatchupSize == 1);
+}
