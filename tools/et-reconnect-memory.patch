+  BackedReader reader(handler, make_shared<CryptoHandler>(key, 0), fd);
+  Packet received;
+  int result = 0;
+  while (result == 0) result = reader.read(&received);
+  CHECK(result == 1);
+  CHECK(received.getPayload() == payload);
+  CHECK(handler->largestRead <= 64 * 1024);
