+  auto handler = make_shared<DiscardWrites>();
+  int fd = handler->createChannel();
+  BackedWriter writer(
+      handler,
+      make_shared<CryptoHandler>("12345678901234567890123456789012", 0), fd);
+  const string payload(1024 * 1024, 'x');
+  for (int i = 0; i < 12; ++i)
+    REQUIRE(writer.write(Packet(i, payload)) ==
+            BackedWriterWriteState::SUCCESS);
+  writer.invalidateSocket();
+  bool recovered = false;
+  try {
+    recovered = writer.recover(0).size() == 12;
+  } catch (const std::runtime_error&) {
+  }
+  std::cout << "REPLAY_WINDOW_MIB=" << ET_RECOVERY_BUFFER_MIB
+            << " LAG_MIB=12 RECOVERED=" << recovered << std::endl;
+  CHECK(recovered == (BackedWriter::MAX_BACKUP_BYTES > 12 * 1024 * 1024));
+}
diff --git a/test/unit_tests/ClientConnectionTest.cpp b/test/unit_tests/ClientConnectionTest.cpp
