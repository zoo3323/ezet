#!/usr/bin/env bash
# ezet [host] [session]   (SSH + Eternal Terminal + tmux)
#   The session screen picks a remote tmux session; without a usable tmux it
#   connects to the SSH shell instead.
#   Connecting through et (Eternal Terminal) keeps colours intact and reconnects
#   by itself across network changes.
#   Without et it falls back to ssh (no auto-reconnect after sleep/roaming).
#
# Interactive list keys:
#   arrows move, Enter picks/connects, q quits
#   session list: arrows pick a session or action, e renames, ← host list
#   host list:    arrows pick a host or action, e edits, d deletes, o reorders
#
# The host argument must be a Host alias from ~/.ssh/config (e.g. dev).
# EZET_DRYRUN=1 prints the target instead of connecting (for tests).
set -euo pipefail

EZET_VERSION="1.0.3"

# ── Dedicated SSH config module ──────────────────────────────────
# Public interface: config_ensure, config_include_present
# Production uses the default paths; tests point the same code at temp files
# through environment variables.
EZET_SSH_CONFIG_FILE="${EZET_SSH_CONFIG_FILE:-$HOME/.ssh/config}"
EZET_HOSTS_FILE="${EZET_HOSTS_FILE:-$HOME/.ssh/config.d/ezet}"
EZET_HOST_ORDER_FILE="${EZET_HOST_ORDER_FILE:-${EZET_HOSTS_FILE}.order}"
EZET_SSH_CONNECT_TIMEOUT="${EZET_SSH_CONNECT_TIMEOUT:-5}"
case "$EZET_SSH_CONNECT_TIMEOUT" in
  ''|*[!0-9]*) EZET_SSH_CONNECT_TIMEOUT=5 ;;
esac
if [ "$EZET_SSH_CONNECT_TIMEOUT" -lt 1 ] || [ "$EZET_SSH_CONNECT_TIMEOUT" -gt 60 ]; then
  EZET_SSH_CONNECT_TIMEOUT=5
fi
SSH_CONNECT_OPTIONS=(-o "ConnectTimeout=$EZET_SSH_CONNECT_TIMEOUT" -o ConnectionAttempts=1)

# SSH connection multiplexing: the session query, refresh, rename and SSH transport
# all reuse one master connection, which removes repeated auth and handshake delay.
# It does not affect the et transport (et takes no ssh options).
# Call this after option parsing but before connecting, so --help/--doctor stay
# side-effect free. It disables itself on OpenSSH older than 6.7 (no %C) or when the
# socket path would approach the platform limit.
EZET_CONTROL_DIR="${EZET_CONTROL_DIR:-$HOME/.ssh/ezet-cm}"
setup_multiplexing() {
  [ -n "${EZET_NO_MULTIPLEX:-}" ] && return 0
  local ver major minor
  ver=$(ssh -V 2>&1 || true)
  case "$ver" in
    OpenSSH_[0-9]*)
      ver="${ver#OpenSSH_}"; ver="${ver%%[!0-9.]*}"
      major="${ver%%.*}"; minor="${ver#*.}"; minor="${minor%%.*}"
      case "$major" in ''|*[!0-9]*) return 0 ;; esac
      case "$minor" in ''|*[!0-9]*) minor=0 ;; esac
      if [ "$major" -lt 6 ] || { [ "$major" -eq 6 ] && [ "$minor" -lt 7 ]; }; then
        return 0
      fi ;;
    *) return 0 ;;
  esac
  # Unix socket path limit (macOS ~104, Linux ~108). Besides the 64 characters of
  # the %C expansion, OpenSSH first creates a temporary listener
  # (<path>.XXXXXXXXXXXXXXXX), so leave generous room.
  [ "$(( ${#EZET_CONTROL_DIR} + 82 ))" -ge 100 ] && return 0
  mkdir -p "$EZET_CONTROL_DIR" 2>/dev/null || return 0
  chmod 700 "$EZET_CONTROL_DIR" 2>/dev/null || true
  [ -d "$EZET_CONTROL_DIR" ] && [ -w "$EZET_CONTROL_DIR" ] || return 0
  SSH_CONNECT_OPTIONS+=(-o ControlMaster=auto -o "ControlPath=$EZET_CONTROL_DIR/%C" -o ControlPersist=30s)
}

config_include_present() {
  [ -f "$EZET_SSH_CONFIG_FILE" ] || return 1
  awk -v target="$EZET_HOSTS_FILE" '
    tolower($1)=="include" {
      rest=$0
      sub(/^[^[:space:]]+[[:space:]]+/, "", rest)
      sub(/^[[:space:]]+/, "", rest)
      sub(/[[:space:]]+$/, "", rest)
      if (substr(rest,1,1)=="\"" && substr(rest,length(rest),1)=="\"") {
        rest=substr(rest,2,length(rest)-2)
      }
      if (rest==target) found=1
    }
    END { exit(found ? 0 : 1) }
  ' "$EZET_SSH_CONFIG_FILE"
}

config_ensure() {
  local ssh_dir config_dir tmp backup
  ssh_dir="${EZET_SSH_CONFIG_FILE%/*}"
  config_dir="${EZET_HOSTS_FILE%/*}"
  case "$EZET_HOSTS_FILE" in *$'\n'*|*'"'*)
    echo "ezet: unsupported config path: $EZET_HOSTS_FILE" >&2
    return 1 ;;
  esac

  # This runs inside `if ! config_ensure`, where errexit is off, so every step that
  # actually changes a file checks its own failure and returns 1 (no false success).
  mkdir -p "$ssh_dir" "$config_dir" || return 1
  chmod 700 "$ssh_dir" "$config_dir" 2>/dev/null || true
  if [ ! -e "$EZET_SSH_CONFIG_FILE" ]; then : > "$EZET_SSH_CONFIG_FILE" || return 1; fi
  if [ ! -e "$EZET_HOSTS_FILE" ]; then : > "$EZET_HOSTS_FILE" || return 1; fi
  chmod 600 "$EZET_SSH_CONFIG_FILE" "$EZET_HOSTS_FILE" 2>/dev/null || true

  if ! config_include_present; then
    backup="$EZET_SSH_CONFIG_FILE.ezet-backup"
    if [ -s "$EZET_SSH_CONFIG_FILE" ] && [ ! -e "$backup" ]; then
      # Overwriting the original after a failed backup risks losing data: stop here.
      cp -p "$EZET_SSH_CONFIG_FILE" "$backup" || return 1
    fi
    tmp="$ssh_dir/.ezet-config.$$"
    if ! {
      printf 'Include "%s"\n' "$EZET_HOSTS_FILE"
      [ ! -s "$EZET_SSH_CONFIG_FILE" ] || { printf '\n'; sed -n '1,$p' "$EZET_SSH_CONFIG_FILE"; }
    } > "$tmp"; then
      rm -f "$tmp" 2>/dev/null || true
      return 1
    fi
    mv "$tmp" "$EZET_SSH_CONFIG_FILE" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
    chmod 600 "$EZET_SSH_CONFIG_FILE" 2>/dev/null || true
  fi
}

# ── Display helpers ──────────────────────────────────────────────
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  RESET=$'\e[0m'; B=$'\e[1m'; DIM=$'\e[2m'
  SEL=$'\e[48;5;237m'      # selected row: near-black dark grey background
  RCF=$'\e[39;22m'         # soft reset: restores colour and weight, keeps background
  CY=$'\e[36m'; GR=$'\e[32m'; YE=$'\e[33m'; RED=$'\e[31m'; BD=$'\e[38;5;240m'; HINT=$'\e[38;5;245m'
else
  RESET='' B='' DIM='' SEL='' RCF='' CY='' GR='' YE='' RED='' BD='' HINT=''
fi

doctor_file_mode() {
  stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null || printf '?'
}

run_doctor() {
  local failures=0 warnings=0 os cmd mode version
  doctor_ok() { printf '  [ok]   %s\n' "$1"; }
  doctor_warn() { printf '  [warn] %s\n' "$1"; warnings=$((warnings + 1)); }
  doctor_fail() { printf '  [fail] %s\n' "$1"; failures=$((failures + 1)); }

  printf 'ezet compatibility check\n\n'
  os=$(uname -s 2>/dev/null || printf unknown)
  case "$os" in
    Darwin|Linux) doctor_ok "OS: $os" ;;
    # Git Bash/MSYS2 report MINGW*/MSYS*. ezet is not tested there, and the Include
    # line it writes uses an MSYS path (/c/Users/...) that Windows OpenSSH cannot
    # resolve. WSL reports Linux and takes the branch above.
    MINGW*|MSYS*|CYGWIN*)
      doctor_fail "unsupported OS: $os (Git Bash/MSYS2 is not supported - run ezet under WSL)" ;;
    *) doctor_fail "unsupported OS: $os (supported: macOS, Linux, WSL)" ;;
  esac

  if [ "${BASH_VERSINFO[0]:-0}" -gt 3 ] || { [ "${BASH_VERSINFO[0]:-0}" -eq 3 ] && [ "${BASH_VERSINFO[1]:-0}" -ge 2 ]; }; then
    doctor_ok "Bash: ${BASH_VERSION}"
  else
    doctor_fail "Bash 3.2 or newer required: ${BASH_VERSION:-unknown}"
  fi

  for cmd in ssh awk sed date seq sleep mktemp cp mv chmod mkdir stat uname; do
    if command -v "$cmd" >/dev/null 2>&1; then doctor_ok "required command: $cmd"
    else doctor_fail "required command not found: $cmd"
    fi
  done

  if command -v et >/dev/null 2>&1; then
    version=$(et --version 2>&1 | sed -n '1p')
    doctor_ok "Eternal Terminal: ${version:-installed}"
  else
    doctor_warn "Eternal Terminal not installed: SSH fallback only"
  fi
  command -v tput >/dev/null 2>&1 || doctor_warn "tput not installed: falling back to a default terminal width"
  command -v expect >/dev/null 2>&1 || doctor_warn "expect not installed: interactive tests cannot run"

  if [ -f "$EZET_SSH_CONFIG_FILE" ]; then
    mode=$(doctor_file_mode "$EZET_SSH_CONFIG_FILE")
    if [ "$mode" = 600 ]; then doctor_ok "SSH config mode: 600"; else doctor_warn "SSH config mode should be 600 (now: $mode)"; fi
  else
    doctor_fail "SSH config missing: $EZET_SSH_CONFIG_FILE"
  fi
  if [ -f "$EZET_HOSTS_FILE" ]; then
    mode=$(doctor_file_mode "$EZET_HOSTS_FILE")
    if [ "$mode" = 600 ]; then doctor_ok "ezet config mode: 600"; else doctor_warn "ezet config mode should be 600 (now: $mode)"; fi
  else
    doctor_fail "ezet config missing: $EZET_HOSTS_FILE"
  fi
  if [ -f "$EZET_HOST_ORDER_FILE" ]; then
    mode=$(doctor_file_mode "$EZET_HOST_ORDER_FILE")
    if [ "$mode" = 600 ]; then doctor_ok "host order file mode: 600"; else doctor_warn "host order file mode should be 600 (now: $mode)"; fi
  fi
  if config_include_present; then doctor_ok "SSH Include linked"
  else doctor_fail "ezet Include missing from SSH config"
  fi
  if [ -f "$EZET_SSH_CONFIG_FILE" ] && ssh -F "$EZET_SSH_CONFIG_FILE" -G ezet-doctor.invalid >/dev/null 2>&1; then
    doctor_ok "SSH config syntax"
  else
    doctor_fail "SSH config syntax error"
  fi

  printf '\nResult: %d failure(s), %d warning(s)\n' "$failures" "$warnings"
  [ "$failures" -eq 0 ]
}

# Reverts only the single Include line ezet added to the SSH config.
# The user's own settings, host list and backup files are never touched.
run_uninstall() {
  local cfg="$EZET_SSH_CONFIG_FILE" tmp answer removed_line=0
  printf '\n  %sUndo ezet install%s\n\n' "$B" "$RESET"
  if ! config_include_present; then
    printf '  No ezet entry in your SSH config. Nothing to undo.\n'
  else
    printf '  Will remove (this one line only):\n'
    printf '    %s%s "%s"%s\n\n' "$CY" 'Include' "$EZET_HOSTS_FILE" "$RESET"
    removed_line=1
  fi
  printf '  %sKept as-is (not deleted)%s\n' "$B" "$RESET"
  [ -f "$EZET_HOSTS_FILE" ] && printf '    host list     %s\n' "$EZET_HOSTS_FILE"
  [ -f "$EZET_HOST_ORDER_FILE" ] && printf '    host order    %s\n' "$EZET_HOST_ORDER_FILE"
  [ -f "$cfg.ezet-backup" ] && printf '    config backup %s\n' "$cfg.ezet-backup"
  printf '    No other SSH settings are touched.\n'
  [ -d "$EZET_CONTROL_DIR" ] && printf '\n  Temp files to clean: %s (connection reuse sockets)\n' "$EZET_CONTROL_DIR"

  if [ "$removed_line" -eq 0 ] && [ ! -d "$EZET_CONTROL_DIR" ]; then
    return 0
  fi
  printf '\n  Proceed? [y/N]: '
  read -r answer || { printf '\n'; return 1; }
  case "$answer" in y|Y|yes|YES) ;; *) printf '  Cancelled.\n'; return 1 ;; esac

  if [ "$removed_line" -eq 1 ]; then
    tmp="${cfg%/*}/.ezet-uninstall.$$"
    # config_ensure prepended 'Include' plus a blank line; only that exact shape has
    # its blank line removed as well.
    if ! awk -v target="$EZET_HOSTS_FILE" '
      function is_our_include(   rest) {
        if (tolower($1) != "include") return 0
        rest=$0
        sub(/^[^[:space:]]+[[:space:]]+/, "", rest)
        sub(/^[[:space:]]+/, "", rest); sub(/[[:space:]]+$/, "", rest)
        if (substr(rest,1,1)=="\"" && substr(rest,length(rest),1)=="\"")
          rest=substr(rest,2,length(rest)-2)
        return (rest==target)
      }
      NR==1 && is_our_include() { dropped_first=1; next }
      NR==2 && dropped_first && $0=="" { next }
      !done_removed && is_our_include() { done_removed=1; next }
      { print }
    ' "$cfg" > "$tmp"; then
      rm -f "$tmp" 2>/dev/null || true
      printf '  Failed: could not read the config. Nothing changed.\n' >&2
      return 1
    fi
    # Validate the syntax before swapping. Anything suspicious leaves the original.
    if ! ssh -F "$tmp" -G ezet-uninstall-check.invalid >/dev/null 2>&1; then
      rm -f "$tmp" 2>/dev/null || true
      printf '  Failed: the resulting config was invalid, so it was aborted. Original untouched.\n' >&2
      return 1
    fi
    chmod 600 "$tmp" 2>/dev/null || true
    if ! mv "$tmp" "$cfg"; then
      rm -f "$tmp" 2>/dev/null || true
      printf '  Failed: could not update the config. Original untouched.\n' >&2
      return 1
    fi
    printf '  Removed: one Include line\n'
  fi
  if [ -d "$EZET_CONTROL_DIR" ]; then
    rm -f "$EZET_CONTROL_DIR"/* 2>/dev/null || true
    rmdir "$EZET_CONTROL_DIR" 2>/dev/null || true
    printf '  Cleaned: connection reuse sockets\n'
  fi
  printf '\n  Done. Your host list stays at %s.\n' "$EZET_HOSTS_FILE"
  printf '  Remove the binary: %sbrew uninstall ezet%s or %srm -f %s%s\n' \
    "$DIM" "$RESET" "$DIM" "$(command -v ezet 2>/dev/null || echo ~/.local/bin/ezet)" "$RESET"
  return 0
}

usage() {
  local code="${1:-1}"
  echo "Usage: ezet [host] [session]" >&2
  echo "Options: -h, --help, -V/--version, --doctor, --uninstall" >&2
  exit "$code"
}

if [ "$#" -gt 2 ]; then
  echo "ezet: at most two arguments (host and session)." >&2
  usage 2
fi

if [ "$#" -gt 0 ]; then
  case "$1" in
    -h|--help) usage 0 ;;
    -V|--version) echo "ezet $EZET_VERSION"; exit 0 ;;
    --doctor) [ "$#" -eq 1 ] || usage 2; run_doctor; exit $? ;;
    --uninstall) [ "$#" -eq 1 ] || usage 2; run_uninstall; exit $? ;;
    -*) echo "ezet: unknown option: $1" >&2; usage 2 ;;
  esac
fi

# ── Connecting ───────────────────────────────────────────────────
# Connect to a session (attach if it exists, otherwise create it). et first, ssh
# as the fallback. Deliberately not exec: the caller refreshes the list afterwards.
connect_session() {
  local session="$1" tmux_bin tmux_command transport et_port=""
  valid_name "$host" || { echo "ezet: invalid host name (letters/digits/._- only): $host" >&2; exit 2; }
  valid_name "$session" || { echo "ezet: invalid session name (letters/digits/._- only): $session" >&2; exit 2; }
  transport=$(connection_transport "$host")
  if [ "$transport" = et ] && load_host_et_port "$host"; then
    et_port="$RESOLVED_ET_PORT"
  fi
  if [ -n "${EZET_DRYRUN:-${DT_DRYRUN:-}}" ]; then
    if [ -n "$et_port" ]; then
      echo "[dryrun] connect $host ← session '$session' via et (port $et_port)"
    else
      echo "[dryrun] connect $host ← session '$session' via $transport"
    fi
    exit 0
  fi
  tmux_bin="${REMOTE_TMUX:-tmux}"
  if [ "$tmux_bin" != tmux ] && ! valid_remote_tmux_path "$tmux_bin"; then tmux_bin=tmux; fi
  tmux_command="'$tmux_bin' new-session -A -s '$session'"
  TERMINAL_SANITIZE_NEEDED=1
  if [ "$transport" = et ]; then
    show_connect_status 'ET + TMUX' "$host ← $session" 'auto-reconnect · Ctrl-C to cancel'
    if [ -n "$et_port" ]; then
      et -p "$et_port" "$host" -c "$tmux_command"
    else
      et "$host" -c "$tmux_command"
    fi
  else
    if command -v et >/dev/null 2>&1; then
      echo "[ezet] no ET external port -> using ssh (set one via host edit)" >&2
    else
      echo "[ezet] et not installed -> ssh fallback (no auto-reconnect after sleep/roaming)" >&2
    fi
    show_connect_status 'SSH + TMUX' "$host ← $session" "up to ${EZET_SSH_CONNECT_TIMEOUT}s · Ctrl-C to cancel"
    ssh "${SSH_CONNECT_OPTIONS[@]}" -t "$host" "$tmux_command"
  fi
}

# Connect to the default remote shell of a host without a usable tmux.
# Not exposed as an `s` shortcut on the session screen: only reached by selecting
# the fallback row with Enter.
connect_plain_ssh() {
  valid_name "$host" || { echo "ezet: invalid host name (letters/digits/._- only): $host" >&2; return 2; }
  if [ -n "${EZET_DRYRUN:-${DT_DRYRUN:-}}" ]; then
    echo "[dryrun] connect $host via ssh (plain shell)"
    return 0
  fi
  show_connect_status 'SSH SHELL' "$host" "up to ${EZET_SSH_CONNECT_TIMEOUT}s · Ctrl-C to cancel"
  TERMINAL_SANITIZE_NEEDED=1
  ssh "${SSH_CONNECT_OPTIONS[@]}" -t "$host"
}

# Resolve the real connection details of a host from the SSH config.
# Result globals: RESOLVED_HOST/RESOLVED_USER/RESOLVED_PORT
resolve_host_fields() {
  local target="${1:-$host}" cfg="$EZET_SSH_CONFIG_FILE" key val
  RESOLVED_HOST=""; RESOLVED_USER=""; RESOLVED_PORT=""
  if [ -f "$cfg" ]; then
    while read -r key val; do
      case "$key" in
        hostname) RESOLVED_HOST="$val" ;;
        user)     RESOLVED_USER="$val" ;;
        port)     RESOLVED_PORT="$val" ;;
      esac
    done < <(ssh -F "$cfg" -G "$target" 2>/dev/null)
  else
    while read -r key val; do
      case "$key" in
        hostname) RESOLVED_HOST="$val" ;;
        user)     RESOLVED_USER="$val" ;;
        port)     RESOLVED_PORT="$val" ;;
      esac
    done < <(ssh -G "$target" 2>/dev/null)
  fi
  [ -n "$RESOLVED_HOST" ]
}

# Address for display (e.g. user@192.0.2.10:2222).
resolve_address() {
  local target="${1:-$host}" addr
  resolve_host_fields "$target" || return 1
  addr="$RESOLVED_HOST"
  [ -n "$RESOLVED_USER" ] && addr="$RESOLVED_USER@$addr"
  [ -n "$RESOLVED_PORT" ] && [ "$RESOLVED_PORT" != "22" ] && addr="$addr:$RESOLVED_PORT"
  printf '%s\n' "$addr"
}

# An explicit Port in the Host block marks an external SSH host created by ezet.
host_has_explicit_port() {
  local target="$1" cfg="$EZET_HOSTS_FILE"
  [ -f "$cfg" ] || return 1
  awk -v target="$target" '
    tolower($1)=="host" || tolower($1)=="match" {
      if (active) exit
      active=0
      if (tolower($1)=="host") {
        for (i=2; i<=NF; i++) {
          if (substr($i,1,1)=="#") break
          if (tolower($i)==tolower(target)) active=1
        }
      }
      next
    }
    active && tolower($1)=="port" { found=1; exit }
    END { exit(found ? 0 : 1) }
  ' "$cfg"
}

# Read the ET port metadata from an ezet-owned Host block.
# It is stored as a `# ezet: et-port PORT` comment so SSH safely ignores it.
# Result global on success: RESOLVED_ET_PORT
load_host_et_port() {
  local target="$1" cfg="$EZET_HOSTS_FILE" value
  RESOLVED_ET_PORT=""
  [ -f "$cfg" ] || return 1
  value=$(awk -v target="$target" '
    tolower($1)=="host" || tolower($1)=="match" {
      if (active) exit
      active=0
      if (tolower($1)=="host") {
        for (i=2; i<=NF; i++) {
          if (substr($i,1,1)=="#") break
          if (tolower($i)==tolower(target)) active=1
        }
      }
      next
    }
    active && $1=="#" && tolower($2)=="ezet:" && tolower($3)=="et-port" {
      print $4
      found=1
      exit
    }
    END { exit(found ? 0 : 1) }
  ' "$cfg") || return 1
  valid_port "$value" || return 1
  RESOLVED_ET_PORT="$value"
  return 0
}

# Returns et or ssh. Even an external-port host uses ET when an ET port is set.
connection_transport() {
  local target="${1:-$host}"
  if ! command -v et >/dev/null 2>&1; then printf 'ssh\n'; return; fi
  if load_host_et_port "$target"; then printf 'et\n'; return; fi
  if host_has_explicit_port "$target"; then printf 'ssh\n'; return; fi
  if resolve_host_fields "$target" && [ -n "$RESOLVED_PORT" ] && [ "$RESOLVED_PORT" != 22 ]; then
    printf 'ssh\n'; return
  fi
  printf 'et\n'
}


INNER_W=46
RULE=""
set_box_width() { INNER_W="$1"; RULE=$(printf '─%.0s' $(seq 1 $((INNER_W + 2)))); }

# The host and session screens size their box by the same rule: fill the terminal
# but stop at 100 columns overall (borders included). The width must not depend on
# the list content, or the table jumps as you move between screens. Whatever space
# is left over is absorbed by each screen's last column.
DASH_MAX_INNER=96
dash_inner_width() {
  local w; w=$(( $(term_cols) - 4 ))
  [ "$w" -gt "$DASH_MAX_INNER" ] && w=$DASH_MAX_INNER
  [ "$w" -lt 20 ] && w=20
  printf '%s' "$w"
}

# Every screen opens with the app name and the current screen, so this reads as one
# small terminal app rather than as plain command output.
app_header() {
  local section="$1"
  printf '  %s●%s  %sezet%s  %s·  %s%s%s\n' \
    "$CY" "$RESET" "$B" "$RESET" "$DIM" "$CY" "$section" "$RESET"
}

box_top() { printf '%s╭%s╮%s\n' "$BD" "$RULE" "$RESET"; }
box_mid() { printf '%s├%s┤%s\n' "$BD" "$RULE" "$RESET"; }
box_bot() { printf '%s╰%s╯%s\n' "$BD" "$RULE" "$RESET"; }
# Every row keeps its first column free for the selection marker (›). That way a
# selected row and a plain row start at the same offset and multi-column tables do
# not look misaligned.
box_line() {
  local plain="$1" rendered="$2" pad
  pad=$(( INNER_W - 1 - ${#plain} )); pad=$(( pad < 0 ? 0 : pad ))
  printf '%s│%s  %s%*s %s│%s\n' "$BD" "$RESET" "$rendered" "$pad" "" "$BD" "$RESET"
}
box_line_sel() {                  # selected row: dark grey background, column colours kept
  local plain="$1" rendered="$2" pad
  pad=$(( INNER_W - 1 - ${#plain} )); pad=$(( pad < 0 ? 0 : pad ))
  # Always draw the marker so the selection is visible with colours turned off.
  printf '%s│%s%s› %s%*s%s %s│%s\n' "$BD" "$RESET" "$SEL" "$rendered" "$pad" "" "$RESET" "$BD" "$RESET"
}
# Display width in terminal cells. Characters of 3 bytes or more (CJK) take 2 cells,
# ASCII and 2-byte characters (·) take 1. Computed from character and byte counts
# alone, with no subprocess, because this runs for every frame.
#   bytes = ascii + 2*mid + 3*wide,  chars = ascii + mid + wide  ⇒  wide = (bytes-chars-mid)/2
# Exception: … is 3 bytes but renders in 1 cell on most terminals, so its extra
# bytes are subtracted separately.
disp_width() {
  local s="$1" chars bytes mid ell tmp tmp2 saved had
  chars=${#s}
  tmp="${s//·/}";   mid=$(( chars - ${#tmp} ))
  tmp2="${tmp//…/}"; ell=$(( ${#tmp} - ${#tmp2} ))
  had=0; [ -n "${LC_ALL+x}" ] && { had=1; saved="$LC_ALL"; }
  LC_ALL=C; bytes=${#s}
  if [ "$had" -eq 1 ]; then LC_ALL="$saved"; else unset LC_ALL; fi
  local wide=$(( (bytes - chars - mid - 2 * ell) / 2 ))
  [ "$wide" -lt 0 ] && wide=0
  printf '%s' $(( chars + wide ))
}
# A terminal cannot shrink text, so the hint is short bright-grey text pinned to the
# top right of the box. `← back` occupies 6 cells (arrow 1 + space 1 + word 4).
box_corner_hint() {
  local text="$1" pad
  pad=$(( INNER_W + 4 - 6 )); [ "$pad" -lt 0 ] && pad=0
  printf '%*s%s%s%s\n' "$pad" "" "$HINT" "$text" "$RESET"
}
box_line_wide() {                 # for lines with wide characters: pad by display width
  local plain="$1" rendered="$2" pad
  pad=$(( INNER_W - 1 - $(disp_width "$plain") )); pad=$(( pad < 0 ? 0 : pad ))
  printf '%s│%s  %s%*s %s│%s\n' "$BD" "$RESET" "$rendered" "$pad" "" "$BD" "$RESET"
}
box_line_wide_sel() {
  local plain="$1" rendered="$2" pad
  pad=$(( INNER_W - 1 - $(disp_width "$plain") )); pad=$(( pad < 0 ? 0 : pad ))
  printf '%s│%s%s› %s%*s%s %s│%s\n' "$BD" "$RESET" "$SEL" "$rendered" "$pad" "" "$RESET" "$BD" "$RESET"
}
row_kv() {
  # Values may contain wide characters, so draw by display width.
  local lbl; printf -v lbl '%-4s' "$1"
  box_line_wide "${lbl}  $2" "${DIM}${lbl}${RESET}  ${3:-}$2${RESET}"
}

fmt_idle() {
  local s; s=$(( $1 < 0 ? -1 : $1 ))
  if   [ "$s" -lt 0 ];     then printf '?'
  elif [ "$s" -lt 60 ];    then printf 'now'
  elif [ "$s" -lt 3600 ];  then printf '%dm' "$((s / 60))"
  elif [ "$s" -lt 86400 ]; then printf '%dh' "$((s / 3600))"
  else                          printf '%dd' "$((s / 86400))"
  fi
}
trunc() {
  local s="$1" n="$2" out="" ch w=0 cw
  # Cut by display width rather than character count, so wide host names cannot
  # overflow the box.
  if [ "${#s}" -le "$n" ] && [ "$(disp_width "$s")" -le "$n" ]; then printf '%s' "$s"; return; fi
  local i
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    cw=1; [ "$(disp_width "$ch")" -eq 2 ] && cw=2
    if [ "$((w + cw))" -gt "$((n - 1))" ]; then break; fi
    out="$out$ch"; w=$((w + cw))
  done
  printf '%s~' "$out"
}
# Remote path for display. Home becomes ~, and when the width is short the front is
# cut with … so the current location (the tail) survives. If not even one parent
# component fits, only the last name is shown.
fmt_dir() {
  local p="$1" n="$2" s base i ch cw w=0 out=""
  # ~ stands for the remote home here: a display string, not a local path to expand.
  # shellcheck disable=SC2088
  case "$p" in
    /home/*/*|/Users/*/*) s="~/${p#/*/*/}" ;;
    /home/*|/Users/*)     s='~' ;;
    /root/*)              s="~/${p#/root/}" ;;
    /root)                s='~' ;;
    *)                    s="$p" ;;
  esac
  [ "$(disp_width "$s")" -le "$n" ] && { printf '%s' "$s"; return; }
  base="${s##*/}"
  [ "$(disp_width "$base")" -ge "$((n - 1))" ] && { trunc "$base" "$n"; return; }
  for (( i=${#s}-1; i>=0; i-- )); do
    ch="${s:i:1}"
    cw=1; [ "$(disp_width "$ch")" -eq 2 ] && cw=2
    if [ "$((w + cw))" -gt "$((n - 1))" ]; then break; fi
    out="$ch$out"; w=$((w + cw))
  done
  printf '…%s' "$out"
}
# Real terminal width: stty (the actual ioctl window size) first, then COLUMNS,
# then tput, then a default.
term_cols() {
  local c=0
  if is_tty; then
    c=$( { stty size </dev/tty | awk '{print $2}'; } 2>/dev/null || true)
  fi
  case "$c" in ''|*[!0-9]*) c=0 ;; esac
  [ "$c" -ge 24 ] && { printf '%s' "$c"; return; }
  c="${COLUMNS:-0}"; case "$c" in ''|*[!0-9]*) c=0 ;; esac
  [ "$c" -ge 24 ] && { printf '%s' "$c"; return; }
  c=$(tput cols 2>/dev/null || true); case "$c" in ''|*[!0-9]*) c=0 ;; esac
  [ "$c" -ge 24 ] && { printf '%s' "$c"; return; }
  printf '80'
}
# Name check (alias/session/user): letters, digits and . _ - only. A leading - is
# rejected because it could be read as an option.
valid_name() { case "$1" in ''|-*|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
# Character check for host name/IPv4/IPv6. The port is taken separately.
valid_addr() { case "$1" in ''|-*|*[!A-Za-z0-9.:_-]*) return 1 ;; *) return 0 ;; esac; }
valid_port() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}
# Only absolute tmux paths that are safe to embed in a remote command are allowed.
valid_remote_tmux_path() {
  case "$1" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$1" in *[!A-Za-z0-9_./+-]*) return 1 ;; *) return 0 ;; esac
}

# Split a user@host or host input.
# Result globals: TARGET_USER/TARGET_HOST/PARSE_ERROR
parse_target() {
  local raw="$1" rest colon_rest
  TARGET_USER=""; TARGET_HOST=""; PARSE_ERROR=""
  case "$raw" in
    *@*)
      TARGET_USER="${raw%%@*}"
      rest="${raw#*@}"
      case "$rest" in
        *@*) PARSE_ERROR="Use @ only once."; return 1 ;;
      esac
      if ! valid_name "$TARGET_USER"; then
        PARSE_ERROR="User name allows letters/digits/._- only."
        return 1
      fi
      TARGET_HOST="$rest"
      ;;
    *) TARGET_HOST="$raw" ;;
  esac
  if ! valid_addr "$TARGET_HOST"; then
    PARSE_ERROR="Enter a host name or IP. (e.g. dev.example.com, 192.0.2.10)"
    return 1
  fi
  # A single colon means a mistyped host:port; IPv6 has two or more.
  case "$TARGET_HOST" in
    *:*)
      colon_rest="${TARGET_HOST#*:}"
      case "$colon_rest" in
        *:*) ;;
        *) PARSE_ERROR="Do not include a port here. Enter only a host or IPv6 address."; return 1 ;;
      esac ;;
  esac
  return 0
}

# Parse a plain address (user@host) or an external SSH address (port user@host).
# Result globals: TARGET_USER/TARGET_HOST/TARGET_PORT/TARGET_EXTERNAL/PARSE_ERROR
parse_connection_input() {
  local raw="$1" first second extra target
  TARGET_PORT=22; TARGET_EXTERNAL=0; PARSE_ERROR=""
  read -r first second extra <<< "$raw"
  if [ -n "${extra:-}" ]; then
    PARSE_ERROR="Use the form user@host, or: port user@host"
    return 1
  fi
  if [ -n "${second:-}" ]; then
    if ! valid_port "$first"; then
      PARSE_ERROR="External port must be a number from 1 to 65535."
      return 1
    fi
    TARGET_PORT="$first"
    TARGET_EXTERNAL=1
    target="$second"
  else
    if valid_port "${first:-}"; then
      PARSE_ERROR="Enter user@host or an IP after the port."
      return 1
    fi
    target="${first:-}"
  fi
  parse_target "$target"
}

is_tty() { [ -t 0 ]; }
clear_screen() { printf '\e[2J\e[H' >&2; }   # clears the screen, keeps the scrollback

# Interactive runs use the terminal's alternate screen, like vim or lazygit: output
# never piles up in the shell scrollback, and quitting returns to exactly the screen
# that was there before ezet. While the remote SSH/tmux owns the terminal we step
# back to the original screen and return afterwards.
DASHBOARD_MODE=0
DASHBOARD_ALT_ACTIVE=0
dashboard_supported() {
  is_tty && [ -t 2 ] && [ "${TERM:-}" != dumb ]
}
dashboard_start() {
  dashboard_supported || return 0
  DASHBOARD_MODE=1
  if [ -n "${EZET_NO_ALT_SCREEN:-}" ]; then
    clear_screen
    return 0
  fi
  printf '\e[?1049h\e[2J\e[H' >&2
  DASHBOARD_ALT_ACTIVE=1
}
dashboard_suspend() {
  [ "$DASHBOARD_ALT_ACTIVE" -eq 1 ] || return 0
  show_cursor
  printf '\e[?1049l' >&2
  DASHBOARD_ALT_ACTIVE=0
}
dashboard_resume() {
  [ "$DASHBOARD_MODE" -eq 1 ] || return 0
  if [ -n "${EZET_NO_ALT_SCREEN:-}" ]; then
    clear_screen
    return 0
  fi
  [ "$DASHBOARD_ALT_ACTIVE" -eq 0 ] || return 0
  printf '\e[?1049h\e[2J\e[H' >&2
  DASHBOARD_ALT_ACTIVE=1
}
dashboard_stop() {
  if [ "$DASHBOARD_ALT_ACTIVE" -eq 1 ]; then
    show_cursor
    printf '\e[?1049l' >&2
    DASHBOARD_ALT_ACTIVE=0
  fi
  DASHBOARD_MODE=0
}

CURSOR_HIDDEN=0
hide_cursor() {
  if [ -t 2 ] && [ "$CURSOR_HIDDEN" -eq 0 ]; then
    printf '\e[?25l' >&2
    CURSOR_HIDDEN=1
  fi
}
show_cursor() {
  if [ -t 2 ] && [ "$CURSOR_HIDDEN" -eq 1 ]; then
    printf '\e[?25h' >&2
    CURSOR_HIDDEN=0
  fi
}

# ── Terminal sanitize after a connection ─────────────────────────
# When et/ssh dies mid-session (network drop, remote kill), the remote tmux has
# no chance to undo the modes it enabled on the local terminal: mouse reporting,
# focus events, bracketed paste, application cursor keys, raw tty. Left on,
# every mouse move floods the dashboard with escape sequences and garbles the
# screen. Reset those modes and drain the already-queued input before reading
# keys again. Only runs after a real connection attempt (flag below), so tests
# and dry runs never touch the tty.
TERMINAL_SANITIZE_NEEDED=0
sanitize_terminal() {
  [ "$TERMINAL_SANITIZE_NEEDED" -eq 1 ] || return 0
  TERMINAL_SANITIZE_NEEDED=0
  [ -t 2 ] || return 0
  # mouse variants (1000/1002/1003 + encodings 1005/1006/1015) · focus (1004)
  # · bracketed paste (2004) · application cursor keys (DECCKM)
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1015l\e[?1004l\e[?2004l\e[?1l' >&2
  stty sane </dev/tty 2>/dev/null || true
  # Fractional read timeouts need bash >= 4 (macOS /bin/bash 3.2 lacks them);
  # there the queued bytes leak once, but the mode resets above stop the flood.
  if is_tty && [ "${BASH_VERSINFO[0]:-0}" -ge 4 ]; then
    while IFS= read -rsn1 -t 0.05 _; do :; done
  fi
}

# ── Activity status ──────────────────────────────────────────────
# A non-interactive query shows a one-line spinner. The real SSH/ET shell owns the
# terminal, so no animation is layered over it - only a connection banner remains.
ACTIVITY_PID=""; ACTIVITY_ACTIVE=0; ACTIVITY_TTY=0
activity_start() {
  local label="$1" detail="${2:-}" suffix="" frame
  stop_activity_silent
  [ -z "$detail" ] || suffix="  ·  $detail"
  ACTIVITY_ACTIVE=1; ACTIVITY_TTY=0; ACTIVITY_PID=""

  if is_tty && [ -t 2 ] && [ "${TERM:-}" != dumb ] && [ -z "${EZET_NO_ANIMATION:-}" ]; then
    ACTIVITY_TTY=1
    frame='⠋'
    printf '\r\e[2K  %s%s%s  %s%s%s%s%s%s' \
      "$CY" "$frame" "$RESET" "$B" "$label" "$RESET" "$DIM" "$suffix" "$RESET" >&2
    (
      frames=('⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏' '⠋')
      i=0
      trap - EXIT
      trap 'exit 0' TERM INT HUP
      while true; do
        sleep 0.08
        frame="${frames[$i]}"
        printf '\r\e[2K  %s%s%s  %s%s%s%s%s%s' \
          "$CY" "$frame" "$RESET" "$B" "$label" "$RESET" "$DIM" "$suffix" "$RESET" >&2
        i=$(( (i + 1) % ${#frames[@]} ))
      done
    ) &
    ACTIVITY_PID=$!
  else
    printf '  …  %s%s\n' "$label" "$suffix" >&2
  fi
}

stop_activity_silent() {
  [ "$ACTIVITY_ACTIVE" -eq 1 ] || return 0
  if [ -n "$ACTIVITY_PID" ]; then
    kill "$ACTIVITY_PID" 2>/dev/null || true
    wait "$ACTIVITY_PID" 2>/dev/null || true
  fi
  [ "$ACTIVITY_TTY" -eq 0 ] || printf '\r\e[2K' >&2
  ACTIVITY_PID=""; ACTIVITY_ACTIVE=0; ACTIVITY_TTY=0
}

activity_stop() {
  local state="$1" label="$2" detail="${3:-}" icon color suffix=""
  stop_activity_silent
  [ -z "$detail" ] || suffix="  ·  $detail"
  case "$state" in
    success) icon='✓'; color="$GR" ;;
    warning) icon='◇'; color="$YE" ;;
    *)       icon='✕'; color="$RED" ;;
  esac
  printf '  %s%s%s  %s%s%s%s%s%s\n' \
    "$color" "$icon" "$RESET" "$B" "$label" "$RESET" "$DIM" "$suffix" "$RESET" >&2
}

# No spinner while SSH may still read a password from /dev/tty: a background redraw
# would paint over the OpenSSH prompt, so the "type it or wait" notice stays fixed.
show_ssh_auth_wait() {
  local target="$1"
  stop_activity_silent
  show_cursor
  printf '  %s◉%s  %sSSH auth check%s  %s%s%s\n' \
    "$YE" "$RESET" "$B" "$RESET" "$CY" "$target" "$RESET" >&2
  printf '     %sType your password if prompted · input stays hidden%s\n' \
    "$B" "$RESET" >&2
  printf '     %sNo prompt means it is still connecting - please wait%s\n' "$DIM" "$RESET" >&2
}

show_connect_status() {
  local kind="$1" target="$2" detail="$3"
  show_cursor
  printf '\n  %s◉%s  %s%-10s%s %s%s%s  %s·  connecting  ·  %s%s\n' \
    "$YE" "$RESET" "$B" "$kind" "$RESET" "$CY" "$target" "$RESET" "$DIM" "$detail" "$RESET" >&2
}

# ── Arrow selection loop + search row ────────────────────────────
# Args: $1=draw function $2=item count $3=allow_new (n key)
#       $4=secondary (edit|order|session|fallback|none)
# Result globals: A_ACTION=item|new|edit|order|order_done|move_up|move_down|back|cancel,
#                 A_IDX (index into the original items)
#
# Fill these globals before calling: FILTER_ITEMS (plain search text per item),
#   FILTER_N (= item count), FILTER_SEARCHABLE (1 draws the search row above the
#   list). Internally it maintains VIS (visible original indexes), CUR (position
#   within VIS), FILTER_ON (whether the search row holds focus) and DREW_LINES.
CUR=0; A_ACTION=""; A_IDX=0
FILTER_ITEMS=(); FILTER_N=0; FILTER_SEARCHABLE=0
FILTER_Q=""; FILTER_ON=0; VIS=(); DREW_LINES=0
# Cursor position (original index) to restore when returning to the list. The caller
# sets it and arrow_loop consumes it. Without this the cursor would jump back to the
# first item after an edit or a cancel, and e/d would hit the wrong entry.
ARROW_START=0

# Case-insensitive subsequence match. An empty query always matches.
fuzzy_match() {
  local hay needle hlen nlen i j
  [ -z "$2" ] && return 0
  hay=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' 2>/dev/null)
  needle=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]' 2>/dev/null)
  # A non-empty query that normalises to nothing (non-ASCII, say) counts as no match
  # rather than as matching everything.
  [ -z "$needle" ] && return 1
  hlen=${#hay}; nlen=${#needle}; j=0
  for (( i=0; i<hlen; i++ )); do
    [ "$j" -ge "$nlen" ] && break
    [ "${hay:i:1}" = "${needle:j:1}" ] && j=$((j + 1))
  done
  [ "$j" -ge "$nlen" ]
}

# Rebuild VIS (the visible original indexes) from the current FILTER_Q.
build_vis() {
  local i
  VIS=()
  if [ -z "$FILTER_Q" ]; then
    for (( i=0; i<FILTER_N; i++ )); do VIS+=("$i"); done
    return
  fi
  for (( i=0; i<FILTER_N; i++ )); do
    if fuzzy_match "${FILTER_ITEMS[$i]}" "$FILTER_Q"; then VIS+=("$i"); fi
  done
}

# The fixed search row right under the list title. With focus it shows the input
# caret, without focus a hint about what is searched. It draws its own separator to
# set the results apart.
draw_search_row() {
  local placeholder="$1" plain rendered
  [ "$FILTER_SEARCHABLE" -eq 1 ] || return 0
  if [ "$FILTER_ON" -eq 1 ]; then
    plain="Search  $FILTER_Q "
    rendered="${B}Search${RCF}  ${CY}${FILTER_Q}${RCF}${DIM}▌${RCF}"
    box_line_wide_sel "$plain" "$rendered"
  elif [ -n "$FILTER_Q" ]; then
    plain="Search  $FILTER_Q"
    rendered="${DIM}Search${RESET}  ${CY}${FILTER_Q}${RESET}"
    box_line_wide "$plain" "$rendered"
  else
    plain="Search  $placeholder"
    rendered="${DIM}${plain}${RESET}"
    box_line_wide "$plain" "$rendered"
  fi
  box_mid
}

arrow_loop() {
  local draw="$1" item_count="$2" allow_new="$3" secondary="$4"
  local first=1 key k2 vis_n ascii_code
  CUR=0; A_ACTION=""; A_IDX=0
  FILTER_Q=""; FILTER_ON=0
  FILTER_N="$item_count"
  build_vis
  # Apply and consume the requested start position (with no filter, a VIS position
  # equals the original index).
  if [ "$ARROW_START" -gt 0 ] 2>/dev/null; then
    if [ "$ARROW_START" -lt "${#VIS[@]}" ]; then CUR="$ARROW_START"
    elif [ "${#VIS[@]}" -gt 0 ]; then CUR=$(( ${#VIS[@]} - 1 ))
    fi
  fi
  ARROW_START=0
  hide_cursor
  while true; do
    vis_n=${#VIS[@]}
    if [ "$vis_n" -eq 0 ] && [ "$FILTER_SEARCHABLE" -eq 1 ] && [ -n "$FILTER_Q" ]; then FILTER_ON=1; fi
    if [ "$FILTER_ON" -eq 0 ]; then
      if [ "$vis_n" -gt 0 ] && [ "$CUR" -ge "$vis_n" ]; then CUR=$((vis_n - 1)); fi
      [ "$vis_n" -eq 0 ] && CUR=0
    fi
    # On a narrow terminal the hint line wraps, which throws the cursor-up redraw off,
    # so clear the whole screen instead. The hint is up to ~75 columns wide, hence the
    # switch below 80.
    if [ "$first" -eq 1 ]; then first=0
    elif [ "$(term_cols)" -lt 80 ]; then clear_screen
    else printf '\e[%dA\r\e[J' "$DREW_LINES" >&2
    fi
    "$draw"
    IFS= read -rsn1 key || { A_ACTION=cancel; break; }

    # While the search row holds focus, every printable character extends the query and
    # filters immediately. ↓/Enter jump to the first result, ↑ to the last.
    if [ "$FILTER_ON" -eq 1 ]; then
      case "$key" in
        $'\e')
          # Clear k2 first: on a timeout (a bare Esc) read leaves the variable alone and
          # the previous sequence would linger.
          k2=""; IFS= read -rsn2 -t1 k2 || true
          case "$k2" in
            '[D'|'OD')
              { [ "$secondary" = session ] || [ "$secondary" = fallback ]; } &&
                { A_ACTION=back; A_IDX="${VIS[$CUR]:-0}"; break; } ;;
            '[A'|'OA')
              if [ "$vis_n" -gt 0 ]; then FILTER_ON=0; CUR=$((vis_n - 1))
              else FILTER_Q=""; build_vis; FILTER_ON=0; CUR=0
              fi ;;
            '[B'|'OB')
              if [ "$vis_n" -gt 0 ]; then FILTER_ON=0; CUR=0
              else FILTER_Q=""; build_vis; FILTER_ON=0; CUR=0
              fi ;;
            '')
              if [ -n "$FILTER_Q" ]; then FILTER_Q=""; build_vis; CUR=0
              else FILTER_ON=0; CUR=0
              fi ;;
          esac ;;
        ''|$'\n'|$'\r')
          [ "$vis_n" -gt 0 ] && { FILTER_ON=0; CUR=0; } ;;
        $'\x7f'|$'\b')
          if [ -n "$FILTER_Q" ]; then FILTER_Q="${FILTER_Q%?}"; build_vis; CUR=0; fi ;;
        *)
          # Only printable ASCII extends the query (multibyte and control bytes are
          # ignored), and its length is capped.
          ascii_code=$(LC_ALL=C printf '%d' "'$key" 2>/dev/null || echo 0)
          if [ "$ascii_code" -ge 32 ] && [ "$ascii_code" -le 126 ] && [ "${#FILTER_Q}" -lt 32 ]; then
            FILTER_Q="$FILTER_Q$key"; build_vis; CUR=0
          fi ;;
      esac
      continue
    fi

    case "$key" in
      $'\e')
        k2=""; IFS= read -rsn2 -t1 k2 || true
        if { [ "$secondary" = session ] || [ "$secondary" = fallback ]; } &&
          { [ "$k2" = '[D' ] || [ "$k2" = 'OD' ]; }; then
          A_ACTION=back
          A_IDX="${VIS[$CUR]:-0}"
          break
        fi
        if [ "$vis_n" -gt 0 ]; then
          case "$k2" in
            '[A'|'OA')
              if [ "$secondary" = order ]; then
                A_ACTION=move_up; A_IDX="${VIS[$CUR]:-0}"; break
              elif [ "$CUR" -eq 0 ] && [ "$FILTER_SEARCHABLE" -eq 1 ]; then
                FILTER_ON=1
              else
                CUR=$(( (CUR - 1 + vis_n) % vis_n ))
              fi ;;
            '[B'|'OB')
              if [ "$secondary" = order ]; then
                A_ACTION=move_down; A_IDX="${VIS[$CUR]:-0}"; break
              elif [ "$CUR" -eq $((vis_n - 1)) ] && [ "$FILTER_SEARCHABLE" -eq 1 ]; then
                FILTER_ON=1
              else
                CUR=$(( (CUR + 1) % vis_n ))
              fi ;;
            '') [ "$secondary" = order ] && { A_ACTION=order_done; A_IDX="${VIS[$CUR]:-0}"; break; } ;;
          esac
        elif [ "$FILTER_SEARCHABLE" -eq 1 ]; then
          case "$k2" in
            '[A'|'OA'|'[B'|'OB') FILTER_ON=1 ;;
          esac
        fi ;;
      ''|$'\n'|$'\r')
        if [ "$vis_n" -gt 0 ] && [ "$secondary" = order ]; then
          A_ACTION=order_done; A_IDX="${VIS[$CUR]}"; break
        elif [ "$vis_n" -gt 0 ]; then A_ACTION=item; A_IDX="${VIS[$CUR]}"; break
        elif [ "$allow_new" -eq 1 ]; then A_ACTION=new; A_IDX=0; break
        fi ;;
      q|Q)
        if [ "$secondary" = order ]; then A_ACTION=order_done
        else A_ACTION=cancel
        fi
        A_IDX="${VIS[$CUR]:-0}"
        break ;;
      e|E)
        [ "$vis_n" -gt 0 ] && { [ "$secondary" = edit ] || [ "$secondary" = session ]; } &&
          { A_ACTION=edit; A_IDX="${VIS[$CUR]}"; break; } ;;
      d|D) [ "$vis_n" -gt 0 ] && [ "$secondary" = edit ] && { A_ACTION=delete; A_IDX="${VIS[$CUR]}"; break; } ;;
      o|O) [ "$vis_n" -gt 0 ] && [ "$secondary" = edit ] && { A_ACTION=order; A_IDX="${VIS[$CUR]}"; break; } ;;
    esac
  done
  show_cursor
}

# ── Host management ──────────────────────────────────────────────
# Collect Host aliases line by line: the ezet config first, then the main
# ~/.ssh/config. Every literal alias on a Host line is emitted (`Host web db` ->
# web, db), while matching patterns (wildcards * ?, negation !, brackets [ ]) and
# case-insensitive duplicates are skipped. This is what lets ezet connect to hosts
# it did not create.
list_host_aliases_raw() {
  local cfg kw rest tok lc out=" "
  for cfg in "$EZET_HOSTS_FILE" "$EZET_SSH_CONFIG_FILE"; do
    [ -f "$cfg" ] || continue
    while read -r kw rest || [ -n "$kw" ]; do
      case "$kw" in [Hh][Oo][Ss][Tt]) ;; *) continue ;; esac
      # Split tokens without globbing (read -a keeps a * inside rest from expanding
      # into file names)
      local toks=()
      read -r -a toks <<< "$rest"
      for tok in ${toks[@]+"${toks[@]}"}; do
        case "$tok" in
          '#'*) break ;;                              # comment starts: ignore the rest
          ''|*'*'*|*'?'*|*'!'*|*'['*|*']'*) continue ;; # patterns are not connectable
        esac
        lc=$(printf '%s' "$tok" | tr '[:upper:]' '[:lower:]')
        case "$out" in *" $lc "*) continue ;; esac
        out="$out$lc "
        printf '%s\n' "$tok"
      done
    done < "$cfg"
  done
}

# Apply the saved user order first, then append newly found hosts in config order.
# Aliases in the order file that no longer exist, and duplicates, are ignored quietly.
list_host_aliases() {
  if [ ! -s "$EZET_HOST_ORDER_FILE" ]; then
    list_host_aliases_raw
    return
  fi
  list_host_aliases_raw | awk -v order_file="$EZET_HOST_ORDER_FILE" '
    BEGIN {
      while ((getline line < order_file) > 0) {
        sub(/\r$/, "", line)
        if (line != "") order[++order_n]=tolower(line)
      }
      close(order_file)
    }
    {
      raw[++raw_n]=$0
      folded[raw_n]=tolower($0)
    }
    END {
      for (i=1; i<=order_n; i++) {
        for (j=1; j<=raw_n; j++) {
          if (!used[j] && folded[j]==order[i]) {
            print raw[j]
            used[j]=1
            break
          }
        }
      }
      for (j=1; j<=raw_n; j++) {
        if (!used[j]) print raw[j]
      }
    }
  '
}

# Atomically save the full on-screen host order to its own file.
# Keeping it out of the SSH config means hosts ezet does not manage can be ordered
# safely too.
save_host_order() {
  local dir tmp alias
  dir="${EZET_HOST_ORDER_FILE%/*}"
  case "$EZET_HOST_ORDER_FILE" in
    *$'\n'*) echo "  Failed to save order: unsupported file path." >&2; return 1 ;;
  esac
  mkdir -p "$dir" || return 1
  chmod 700 "$dir" 2>/dev/null || true
  tmp="$dir/.ezet-order.$$"
  if ! {
    for alias in "$@"; do
      [ -z "$alias" ] || printf '%s\n' "$alias"
    done
  } > "$tmp"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  if ! mv "$tmp" "$EZET_HOST_ORDER_FILE"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
}

# Keep the saved position after a rename or delete, and leave no stale alias behind.
update_host_order_alias() {
  local old="$1" new="${2:-}" dir tmp
  [ -f "$EZET_HOST_ORDER_FILE" ] || return 0
  dir="${EZET_HOST_ORDER_FILE%/*}"
  tmp="$dir/.ezet-order.$$"
  if ! awk -v old="$old" -v new="$new" '
    tolower($0)==tolower(old) {
      if (new!="") print new
      next
    }
    { print }
  ' "$EZET_HOST_ORDER_FILE" > "$tmp"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  if ! mv "$tmp" "$EZET_HOST_ORDER_FILE"; then
    rm -f "$tmp" 2>/dev/null || true
    return 1
  fi
}

# Whether an alias exists as a literal Host in a given config file (case-insensitive,
# same rule as host_alias_exists). Used to tell which hosts ezet may edit or delete.
host_in_file() {
  local alias="$1" cfg="$2"
  [ -f "$cfg" ] || return 1
  awk -v alias="$alias" '
    tolower($1)=="host" {
      for (i=2; i<=NF; i++) {
        if (substr($i,1,1)=="#") break
        if (tolower($i)==tolower(alias)) found=1
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$cfg"
}

# Whether the same literal alias exists in any Host pattern (case-insensitive).
host_alias_exists() {
  local alias="$1" cfg
  for cfg in "$EZET_HOSTS_FILE" "$EZET_SSH_CONFIG_FILE"; do
    [ -f "$cfg" ] || continue
    if awk -v alias="$alias" '
      tolower($1)=="host" {
        for (i=2; i<=NF; i++) {
          if (substr($i,1,1)=="#") break
          if (tolower($i)==tolower(alias)) found=1
        }
      }
      END { exit(found ? 0 : 1) }
    ' "$cfg"; then
      return 0
    fi
  done
  return 1
}

# ── List status line ─────────────────────────────────────────────
# Results of add/edit/delete/rename used to be invisible: the screen was cleared
# right after printing them. Keep the result and show it as one line under the list
# (until the next action).
HOST_STATUS=''; HOST_STATUS_KIND='ok'; HOST_STATUS_NOTE=''
host_status() {                   # $1=ok|err  $2=result  $3=extra note (optional)
  HOST_STATUS_KIND="$1"; HOST_STATUS="$2"; HOST_STATUS_NOTE="${3:-}"
}
host_status_clear() { HOST_STATUS=''; HOST_STATUS_NOTE=''; HOST_STATUS_KIND='ok'; }
# Hosts read from the main SSH config are listed (and connectable) but ezet never
# rewrites that file, so `e` and `d` refuse them - the `ro` tag in the list says so.
# The refusal used to go to stderr, which clear_screen wiped on the same breath:
# the key looked dead. Say it on the status line instead, and say how to fix it.
read_only_status() {              # $1=alias  $2=edit|delete
  host_status err "Cannot $2 '$1': it lives in your main SSH config." \
    "ezet only writes ${EZET_HOSTS_FILE/#$HOME/\~} - move the Host block there to manage it here."
}
SESSION_STATUS=''; SESSION_STATUS_KIND='ok'
session_status() { SESSION_STATUS_KIND="$1"; SESSION_STATUS="$2"; }
session_status_clear() { SESSION_STATUS=''; SESSION_STATUS_KIND='ok'; }
# Both screens draw the status line the same way. The line itself is printed, while
# the number of rows drawn is returned through the global STATUS_ROWS (taking it via
# command substitution would swallow the printed text as well).
STATUS_ROWS=0
draw_status_line() {              # $1=kind $2=text $3=extra note
  local kind="$1" text="$2" note="$3"
  STATUS_ROWS=0
  [ -z "$text" ] && return 0
  if [ "$kind" = err ]; then printf '  %s✗ %s%s\n' "$RED" "$text" "$RESET"
  else printf '  %s✓%s %s\n' "$GR" "$RESET" "$text"
  fi
  STATUS_ROWS=1
  if [ -n "$note" ]; then printf '    %s%s%s\n' "$DIM" "$note" "$RESET"; STATUS_ROWS=2; fi
  return 0
}

# ── Host add/edit form ───────────────────────────────────────────
# Instead of stacking prompts under the list, each step redraws one screen in place.
# The values entered so far, the remaining fields and the hints for the current field
# are always visible together. Input stays on read -r, so paste and backspace keep
# working. AF_MODE=add|edit changes only the title and the hints; the layout is one.
AF_MODE='add'; AF_TITLE=''; AF_ET_CURRENT=''; AF_ALIAS_DEFAULT=''
AF_ADDR=''; AF_ET=''; AF_ALIAS=''; AF_EXTERNAL=0; AF_ERROR=''
# Special keys in the form. 0=ordinary input, 1=cancel, 2=back one step.
# Line input (read -r) cannot capture arrow keys per keystroke, so the typeable `<`
# is the back key; pressing ← and then Enter (which lands the escape sequence in the
# line) is accepted as well.
af_key() {
  case "$1" in
    q|Q)                       return 1 ;;
    '<'|'‹'|$'\e[D'|$'\eOD')   return 2 ;;
  esac
  return 0
}
# Address for display, shaped like the list ADDRESS column. The input format is
# explained by the examples below.
af_addr_display() {               # $1=user $2=host $3=port $4=external
  local out="${1:+$1@}$2"
  [ "$4" -eq 1 ] && out="$out:$3"
  printf '%s' "$out"
}
# One form row: label + value (a dim hint when empty). The current field is drawn as
# the selected row.
af_row() {
  local cur="$1" own="$2" label="$3" value="$4" hint="$5" lbl txt rend vw
  vw=$(( INNER_W - 12 )); [ "$vw" -lt 8 ] && vw=8
  printf -v lbl '%-9s' "$label"
  if [ -n "$value" ]; then
    txt="$(trunc "$value" "$vw")"; rend="${DIM}${lbl}${RCF} ${CY}${B}${txt}${RCF}"
  else
    txt="$(trunc "$hint" "$vw")"; rend="${DIM}${lbl}${RCF} ${DIM}${txt}${RCF}"
  fi
  if [ "$cur" = "$own" ]; then box_line_wide_sel "${lbl} ${txt}" "$rend"
  else box_line_wide "${lbl} ${txt}" "$rend"; fi
}
# One example line: name · format · a real example.
af_example() {
  local name="$1" form="$2" sample="$3" n f plain
  printf -v n '%-10s' "$name"; printf -v f '%-22s' "$form"
  plain="${n}${f}${sample}"
  box_line_wide "$(trunc "$plain" "$((INNER_W - 1))")" \
    "${DIM}${n}${RCF}${YE}${f}${RCF}${DIM}${sample}${RCF}"
}
af_note() { box_line_wide "$(trunc "$1" "$((INNER_W - 1))")" "${DIM}$(trunc "$1" "$((INNER_W - 1))")${RESET}"; }
draw_host_form() {
  local step="$1" width total=2 idx=1 counter pad label title trend section
  width=$(dash_inner_width); set_box_width "$width"
  # The ET port field only exists for an external SSH host, so the total step count
  # grows only then.
  [ "$AF_EXTERNAL" -eq 1 ] && total=3
  case "$step" in
    addr)  idx=1; label='ADDRESS' ;;
    et)    idx=2; label='ET PORT' ;;
    alias) idx=$total; label='ALIAS' ;;
  esac
  counter="step $idx of $total"
  if [ "$AF_MODE" = edit ]; then
    section='EDIT HOST'; title="EDIT HOST  $AF_TITLE"
    trend="${B}EDIT HOST${RESET}  ${CY}${B}${AF_TITLE}${RESET}"
  else
    section='NEW HOST'; title='ADD HOST'
    trend="${B}ADD HOST${RESET}"
  fi
  pad=$(( INNER_W - 1 - ${#title} - ${#counter} )); [ "$pad" -lt 1 ] && pad=1
  is_tty && clear_screen
  {
    app_header "$section"
    box_top
    box_line_wide "${title}$(printf '%*s' "$pad" '')${counter}" \
                  "${trend}$(printf '%*s' "$pad" '')${DIM}${counter}${RESET}"
    box_mid
    af_row "$step" addr 'ADDRESS' "$AF_ADDR" 'user@host   or   PORT user@public-ip'
    [ "$AF_EXTERNAL" -eq 1 ] && af_row "$step" et 'ET PORT' "$AF_ET" 'not set · SSH only'
    af_row "$step" alias 'ALIAS' "$AF_ALIAS" 'short name you type after ezet'
    box_mid
    case "$step" in
      addr)
        af_example 'plain'    'user@host'            'dev@192.0.2.10'
        af_example 'external' 'PORT user@public-ip'  '30001 ops@203.0.113.8'
        if [ "$AF_MODE" = edit ]; then af_note 'Enter = keep current  ·  q = cancel'
        else af_note 'Enter or q = cancel'
        fi ;;
      et)
        af_note 'ET port forwards the remote 2022 for Eternal Terminal.'
        if [ -n "$AF_ET_CURRENT" ]; then
          af_note "Enter = keep ${AF_ET_CURRENT}  ·  - = SSH only  ·  < = back  ·  q = cancel"
        else
          af_note 'Enter = SSH only  ·  < = back  ·  q = cancel'
        fi ;;
      alias)
        af_note "Enter = ${AF_ALIAS_DEFAULT}  ·  < = back  ·  q = cancel"
        af_note 'Letters, digits and . _ - only' ;;
    esac
    box_bot
    echo
    [ -n "$AF_ERROR" ] && printf '  %s✗ %s%s\n\n' "$RED" "$AF_ERROR" "$RESET"
    printf '  %s%-7s%s %s▸%s ' "$B" "$label" "$RESET" "$YE" "$RESET"
  } >&2
}

# Add a new host to the ezet config. 0 on success, 1 on cancel or failure.
# (Prompts go to stderr.)
add_host() {
  local cfg="$EZET_HOSTS_FILE" alias input addr user port external et_port="" defaulted shown step
  host_status_clear
  AF_MODE='add'; AF_TITLE=''; AF_ET_CURRENT=''; AF_ALIAS_DEFAULT=''
  AF_ADDR=''; AF_ET=''; AF_ALIAS=''; AF_EXTERNAL=0; AF_ERROR=''
  # The step is kept as state so the fields can be walked forwards and backwards.
  step='addr'
  while [ "$step" != 'done' ]; do
    draw_host_form "$step"
    case "$step" in
      addr)
        read -r input || return 1
        af_key "$input"; case $? in 1|2) return 1 ;; esac   # back on the first field = cancel
        [ -z "$input" ] && return 1
        if ! parse_connection_input "$input"; then
          AF_ERROR="Invalid address. $PARSE_ERROR"
          continue
        fi
        addr="$TARGET_HOST"; user="$TARGET_USER"
        port="$TARGET_PORT"; external="$TARGET_EXTERNAL"
        AF_ERROR=''; AF_EXTERNAL="$external"
        AF_ADDR="$(af_addr_display "$user" "$addr" "$port" "$external")"
        AF_ALIAS_DEFAULT="$addr"
        # Going back and retyping a plain address must drop any ET port entered
        # earlier, or it would be written to a host that has no forwarding for it.
        if [ "$external" -eq 1 ]; then step='et'; else et_port=''; AF_ET=''; step='alias'; fi ;;
      et)
        read -r input || return 1
        af_key "$input"; case $? in 1) return 1 ;; 2) step='addr'; AF_ERROR=''; continue ;; esac
        if [ -z "$input" ]; then
          et_port=''; AF_ET='SSH only'; AF_ERROR=''; step='alias'; continue
        fi
        if valid_port "$input"; then
          et_port="$input"; AF_ET="$et_port"; AF_ERROR=''; step='alias'; continue
        fi
        AF_ERROR='ET external port must be a number from 1 to 65535.' ;;
      alias)
        read -r alias || return 1
        af_key "$alias"
        case $? in
          1) return 1 ;;
          2) AF_ERROR=''
             if [ "$external" -eq 1 ]; then step='et'; else step='addr'; fi
             continue ;;
        esac
        defaulted=0
        if [ -z "$alias" ]; then alias="$addr"; defaulted=1; fi
        if ! valid_name "$alias"; then
          if [ "$defaulted" -eq 1 ]; then
            AF_ERROR='That address cannot be used as an alias. Use letters/digits/._- only.'
          else
            AF_ERROR='Invalid alias. Letters/digits/._- only.'
          fi
          continue
        fi
        if host_alias_exists "$alias"; then
          AF_ERROR="Alias already exists: $alias"
          continue
        fi
        AF_ERROR=''; AF_ALIAS="$alias"; step='done' ;;
    esac
  done
  mkdir -p "$HOME/.ssh" 2>/dev/null || true; chmod 700 "$HOME/.ssh" 2>/dev/null || true
  # This runs inside `if add_host`/`&&` where errexit is off, so the append failure is
  # checked here. The &&-chain verifies every real write; optional entries (User/Port)
  # evaluate true when absent, which avoids the group returning 1 just because its last
  # command was a false test.
  if ! {
    printf '\nHost %s\n'      "$alias" &&
    printf '    HostName %s\n' "$addr" &&
    { [ -z "$user" ]      || printf '    User %s\n' "$user"; } &&
    { [ "$external" -ne 1 ] || printf '    Port %s\n' "$port"; } &&
    { [ -z "$et_port" ]     || printf '    # ezet: et-port %s\n' "$et_port"; }
  } >> "$cfg"; then
    host_status err "Add failed: cannot write to the config file: $cfg"
    return 1
  fi
  chmod 600 "$cfg" 2>/dev/null || true
  shown="${user:+$user@}$addr"
  if [ "$external" -eq 1 ]; then
    shown="$shown:$port (external SSH"
    if [ -n "$et_port" ]; then shown="$shown · ET $et_port"; else shown="$shown · SSH only"; fi
    shown="$shown)"
  fi
  host_status ok "Added: $alias -> $shown"
  return 0
}

# Read the HostName/User/Port written directly in the selected Host block, plus the
# ezet ET port.
# Result globals: HOST_DETAIL_ADDR/HOST_DETAIL_USER/HOST_DETAIL_PORT/HOST_DETAIL_HAS_PORT/
#             HOST_DETAIL_ET_PORT/HOST_DETAIL_PATTERNS
load_host_details() {
  local alias="$1" cfg="$EZET_HOSTS_FILE" details rest
  [ -f "$cfg" ] || return 1
  details=$(awk -v alias="$alias" '
    BEGIN { target=0; found=0; h=""; u=""; p=""; ep=""; patterns=0 }
    tolower($1)=="host" || tolower($1)=="match" {
      if (found) exit
      target=0
      if (tolower($1)=="host") {
        patterns=0
        for (i=2; i<=NF; i++) {
          if (substr($i,1,1)=="#") break
          patterns++
          if (tolower($i)==tolower(alias)) { target=1; found=1 }
        }
      }
      next
    }
    target && tolower($1)=="hostname" && h=="" { h=$2; next }
    target && tolower($1)=="user" && u=="" { u=$2; next }
    target && tolower($1)=="port" && p=="" { p=$2; next }
    target && $1=="#" && tolower($2)=="ezet:" && tolower($3)=="et-port" && ep=="" {
      ep=$4
      next
    }
    END { if (found) print h "|" u "|" p "|" ep "|" patterns; else exit 3 }
  ' "$cfg") || return 1
  HOST_DETAIL_ADDR="${details%%|*}"
  rest="${details#*|}"
  HOST_DETAIL_USER="${rest%%|*}"
  rest="${rest#*|}"
  HOST_DETAIL_PORT="${rest%%|*}"
  rest="${rest#*|}"
  HOST_DETAIL_ET_PORT="${rest%%|*}"
  HOST_DETAIL_PATTERNS="${rest##*|}"
  valid_port "$HOST_DETAIL_ET_PORT" || HOST_DETAIL_ET_PORT=""
  [ -z "$HOST_DETAIL_ADDR" ] && HOST_DETAIL_ADDR="$alias"
  if [ -n "$HOST_DETAIL_PORT" ]; then HOST_DETAIL_HAS_PORT=1
  else HOST_DETAIL_HAS_PORT=0; HOST_DETAIL_PORT=22
  fi
  return 0
}

# Atomically update the Host alias/HostName/User/Port/ET port while preserving every
# other option. In a shared block such as `Host old sibling`, only old is split into
# its own block so sibling is unaffected.
update_host() {
  local old="$1" new="$2" addr="$3" user="$4" port="$5" write_port="$6" et_port="$7"
  local cfg="$EZET_HOSTS_FILE" tmp="${EZET_HOSTS_FILE%/*}/.ezet.tmp.$$"
  [ -f "$cfg" ] || return 1
  if awk -v old="$old" -v new="$new" -v addr="$addr" -v user="$user" -v port="$port" \
    -v write_port="$write_port" -v et_port="$et_port" '
    function is_et_port_marker() {
      return ($1=="#" && tolower($2)=="ezet:" && tolower($3)=="et-port")
    }
    function finish_target() {
      if (!target) return
      if (!seen_hostname) print "    HostName " addr
      if (user!="" && !seen_user) print "    User " user
      if (write_port && !seen_port) print "    Port " port
      if (et_port!="" && !seen_et_port) print "    # ezet: et-port " et_port
    }
    function finish_shared( i) {
      if (!shared) return
      if (!seen_hostname) print "    HostName " addr
      if (user!="" && !seen_user) print "    User " user
      if (write_port && !seen_port) print "    Port " port
      if (et_port!="" && !seen_et_port) print "    # ezet: et-port " et_port
      print sibling_header
      for (i=1; i<=buffer_count; i++) {
        print original[i]
        delete original[i]
      }
      buffer_count=0
      shared=0
    }
    {
      key=tolower($1)
      if (key=="host" || key=="match") {
        if (shared) finish_shared(); else finish_target()
        target=0; seen_hostname=0; seen_user=0; seen_port=0; seen_et_port=0
        matched=0; pattern_count=0
        if (key=="host" && !found) {
          for (i=2; i<=NF; i++) {
            if (substr($i,1,1)=="#") break
            pattern_count++
            if ($i==old) matched=1
          }
        }
        if (matched) {
          found=1
          if (pattern_count>1) {
            shared=1
            sibling_header=$1
            in_comment=0
            for (i=2; i<=NF; i++) {
              if (substr($i,1,1)=="#") in_comment=1
              if (!in_comment && $i==old) continue
              sibling_header=sibling_header " " $i
            }
            print "Host " new
            next
          }
          for (i=2; i<=NF; i++) {
            if (substr($i,1,1)=="#") break
            if ($i==old) $i=new
          }
          target=1
          print
          next
        }
        print
        next
      }
      if (shared) {
        original[++buffer_count]=$0
        if (is_et_port_marker()) {
          if (et_port!="" && !seen_et_port) print "    # ezet: et-port " et_port
          seen_et_port=1
          next
        }
        if (key=="hostname") {
          if (!seen_hostname) print "    HostName " addr
          seen_hostname=1
          next
        }
        if (key=="user") {
          if (!seen_user && user!="") print "    User " user
          seen_user=1
          next
        }
        if (key=="port") {
          if (write_port && !seen_port) print "    Port " port
          seen_port=1
          next
        }
        print
        next
      }
      if (target && key=="hostname") {
        if (!seen_hostname) print "    HostName " addr
        seen_hostname=1
        next
      }
      if (target && key=="user") {
        if (!seen_user && user!="") print "    User " user
        seen_user=1
        next
      }
      if (target && key=="port") {
        if (write_port && !seen_port) print "    Port " port
        seen_port=1
        next
      }
      if (target && is_et_port_marker()) {
        if (et_port!="" && !seen_et_port) print "    # ezet: et-port " et_port
        seen_et_port=1
        next
      }
      print
    }
    END {
      if (shared) finish_shared(); else finish_target()
      if (!found) exit 3
    }
  ' "$cfg" > "$tmp"; then
    mv "$tmp" "$cfg" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
    chmod 600 "$cfg" 2>/dev/null || true
  else
    rm -f "$tmp"
    return 1
  fi
}

# Edit a host address, user and alias.
edit_host() {
  local old="$1" input addr user port external et_port alias current target shown note='' step
  local original_addr original_user original_port original_external original_et_port shared=0
  host_status_clear
  if ! load_host_details "$old"; then
    host_status err "Edit failed: '$old' was not found in the ezet config."
    return 1
  fi
  [ "$HOST_DETAIL_PATTERNS" -gt 1 ] && shared=1
  addr="$HOST_DETAIL_ADDR"; user="$HOST_DETAIL_USER"
  port="$HOST_DETAIL_PORT"; external="$HOST_DETAIL_HAS_PORT"; et_port="$HOST_DETAIL_ET_PORT"
  original_addr="$addr"; original_user="$user"; original_port="$port"
  original_external="$external"; original_et_port="$et_port"
  target="${user:+$user@}$addr"
  if [ "$external" -eq 1 ]; then current="$port $target"; else current="$target"; fi

  AF_MODE='edit'; AF_TITLE="$old"; AF_ERROR=''
  AF_EXTERNAL="$external"; AF_ET_CURRENT="$et_port"; AF_ALIAS_DEFAULT="$old"
  AF_ADDR="$(af_addr_display "$user" "$addr" "$port" "$external")"
  AF_ET="${et_port:-SSH only}"; AF_ALIAS="$old"
  # Same state machine as the add form; `<` steps back a field.
  step='addr'
  while [ "$step" != 'done' ]; do
    draw_host_form "$step"
    case "$step" in
      addr)
        read -r input || return 1
        af_key "$input"; case $? in 1|2) return 1 ;; esac   # back on the first field = cancel
        [ -z "$input" ] && input="$current"
        if ! parse_connection_input "$input"; then
          AF_ERROR="Invalid address. $PARSE_ERROR"
          continue
        fi
        addr="$TARGET_HOST"; user="$TARGET_USER"
        port="$TARGET_PORT"; external="$TARGET_EXTERNAL"
        AF_ERROR=''; AF_EXTERNAL="$external"
        AF_ADDR="$(af_addr_display "$user" "$addr" "$port" "$external")"
        if [ "$external" -eq 1 ]; then step='et'; else et_port=""; step='alias'; fi ;;
      et)
        read -r input || return 1
        af_key "$input"; case $? in 1) return 1 ;; 2) step='addr'; AF_ERROR=''; continue ;; esac
        case "$input" in
          -)  et_port=''; AF_ET='SSH only'; AF_ERROR=''; step='alias'; continue ;;
          '') et_port="$AF_ET_CURRENT"; AF_ET="${et_port:-SSH only}"; AF_ERROR=''; step='alias'; continue ;;
        esac
        if valid_port "$input"; then
          et_port="$input"; AF_ET="$et_port"; AF_ERROR=''; step='alias'; continue
        fi
        AF_ERROR='ET external port must be a number from 1 to 65535.' ;;
      alias)
        read -r alias || return 1
        af_key "$alias"
        case $? in
          1) return 1 ;;
          2) AF_ERROR=''
             if [ "$external" -eq 1 ]; then step='et'; else step='addr'; fi
             continue ;;
        esac
        [ -z "$alias" ] && alias="$old"
        if ! valid_name "$alias"; then
          AF_ERROR='Invalid alias. Letters/digits/._- only.'
          continue
        fi
        if [ "$alias" != "$old" ] && host_alias_exists "$alias"; then
          AF_ERROR="Alias already exists: $alias"
          continue
        fi
        AF_ERROR=''; AF_ALIAS="$alias"; step='done' ;;
    esac
  done

  if [ "$alias" = "$old" ] && [ "$addr" = "$original_addr" ] && [ "$user" = "$original_user" ] \
    && [ "$port" = "$original_port" ] && [ "$external" = "$original_external" ] \
    && [ "$et_port" = "$original_et_port" ]; then
    host_status ok 'No change.'
    return 0
  fi
  if update_host "$old" "$alias" "$addr" "$user" "$port" "$external" "$et_port"; then
    if [ "$alias" != "$old" ] && ! update_host_order_alias "$old" "$alias"; then
      note='Note: the address was changed, but the saved host order was not updated.'
    fi
    shown="${user:+$user@}$addr"
    if [ "$external" -eq 1 ]; then
      shown="$shown:$port (external SSH"
      if [ -n "$et_port" ]; then shown="$shown · ET $et_port"; else shown="$shown · SSH only"; fi
      shown="$shown)"
    fi
    [ "$shared" -eq 1 ] && note="Split: '$alias' now has its own block, separated from the shared Host block."
    host_status ok "Changed: $alias -> $shown" "$note"
    return 0
  fi
  host_status err 'Edit failed: could not update the ezet config.'
  return 1
}

# Delete confirmation screen: shows what goes away and what is left alone.
draw_delete_form() {              # $1=alias $2=address
  local width
  width=$(dash_inner_width); set_box_width "$width"
  is_tty && clear_screen
  {
    app_header 'DELETE HOST'
    box_top
    box_line_wide 'DELETE HOST' "${RED}${B}DELETE HOST${RESET}"
    box_mid
    af_row none x 'HOST'    "$1"        '-'
    af_row none x 'ADDRESS' "${2:-?}"   '-'
    box_mid
    af_note 'Removes this Host block from the ezet SSH config.'
    af_note 'Your main ~/.ssh/config is not touched.'
    box_bot
    echo
    printf '  %sReally delete?%s [y/N] %s▸%s ' "$B" "$RESET" "$YE" "$RESET"
  } >&2
}

# Atomically delete the selected Host alias from the ezet config.
# In a shared block (`Host dev gpu`) only that alias is removed; the rest is kept.
delete_host() {
  local alias="$1" cfg="$EZET_HOSTS_FILE" tmp="${EZET_HOSTS_FILE%/*}/.ezet.tmp.$$"
  local answer address note=''
  host_status_clear
  address=$(resolve_address "$alias" 2>/dev/null || true)
  draw_delete_form "$alias" "$address"
  read -r answer || return 1
  case "$answer" in y|Y|yes|YES) ;; *) return 1 ;; esac

  [ -f "$cfg" ] || { host_status err 'Delete failed: the ezet config file does not exist.'; return 1; }
  if awk -v alias="$alias" '
    {
      key=tolower($1)
      if (key=="host" || key=="match") {
        if (skipping) skipping=0
        matched=0; patterns=0
        if (key=="host" && !found) {
          for (i=2; i<=NF; i++) {
            if (substr($i,1,1)=="#") break
            patterns++
            if ($i==alias) matched=1
          }
        }
        if (matched) {
          found=1
          if (patterns==1) {
            skipping=1
            next
          }
          header=$1
          in_comment=0
          for (i=2; i<=NF; i++) {
            if (substr($i,1,1)=="#") in_comment=1
            if (!in_comment && $i==alias) continue
            header=header " " $i
          }
          print header
          next
        }
      }
      if (!skipping) print
    }
    END { if (!found) exit 3 }
  ' "$cfg" > "$tmp"; then
    mv "$tmp" "$cfg" || { rm -f "$tmp" 2>/dev/null || true; host_status err 'Delete failed: could not update the config file.'; return 1; }
    chmod 600 "$cfg" 2>/dev/null || true
    if ! update_host_order_alias "$alias" ""; then
      note='Note: the host was deleted, but not removed from the saved order.'
    fi
    host_status ok "Deleted: $alias" "$note"
    return 0
  fi
  rm -f "$tmp"
  host_status err "Delete failed: '$alias' was not found."
  return 1
}

# Draw the host list (uses the globals HN/HROW_*/HREND/VIS/CUR/FILTER_*, writes stderr)
HROW_PLAIN=(); HREND=(); HROW_ACTION=(); HN=0; HOST_ACTION_COUNT=0; HOST_ORDER_MODE=0
HTH_PLAIN=''                      # host table column header (pick_host fills it per width)
draw_hosts() {
  local pos orig rows=0 search_rows=0 status_rows=0 total hdr host_total=0 plain rendered
  total=${#VIS[@]}
  for orig in "${VIS[@]}"; do [ "$orig" -lt "$HN" ] && host_total=$((host_total + 1)); done
  {
    app_header 'SSH HOSTS'
    box_top
    if [ "$HOST_ORDER_MODE" -eq 1 ]; then
      hdr="HOST ORDER ($HN)"
    elif [ -n "$FILTER_Q" ]; then
      hdr="SSH HOSTS ($host_total/$HN)"
    else
      hdr="SSH HOSTS ($HN)"
    fi
    box_line_wide "$hdr" "${B}${hdr}${RESET}"
    box_mid
    if [ "$FILTER_SEARCHABLE" -eq 1 ]; then
      draw_search_row "host name or address"
      search_rows=2
    fi
    if [ -n "$HTH_PLAIN" ]; then
      box_line_wide "$HTH_PLAIN" "${DIM}${HTH_PLAIN}${RESET}"
      rows=$((rows + 1))
    fi
    if [ "$total" -eq 0 ]; then
      box_line_wide "no matches" "${DIM}no matches${RESET}"
      rows=$((rows + 1))
    else
      for pos in "${!VIS[@]}"; do
        orig="${VIS[$pos]}"
        # `＋ New Host` (orig=HN) is appended as the last row of the list, with no separator.
        plain="${HROW_PLAIN[$orig]}"; rendered="${HREND[$orig]}"
        if [ "$FILTER_ON" -eq 0 ] && [ "$pos" -eq "$CUR" ]; then box_line_wide_sel "$plain" "$rendered"
        else box_line_wide "$plain" "$rendered"; fi
        rows=$((rows + 1))
      done
    fi
    box_bot
    echo
    if [ "$HOST_ORDER_MODE" -eq 1 ]; then
      printf '  %s↑/↓%s move · %sEnter%s done · %sEsc%s cancel\n' \
        "$B" "$RESET" "$B" "$RESET" "$B" "$RESET"
    else
      printf '  %se%s edit · %sd%s delete · %so%s reorder · %sq%s quit\n' \
        "$B" "$RESET" "$B" "$RESET" "$B" "$RESET" "$B" "$RESET"
    fi
    draw_status_line "$HOST_STATUS_KIND" "$HOST_STATUS" "$HOST_STATUS_NOTE"; status_rows=$STATUS_ROWS
  } >&2
  DREW_LINES=$((7 + rows + search_rows + status_rows))
}

# Pick a host and print its name to stdout. Returns 1 when cancelled.
pick_host() {
  is_tty || { pick_host_text; return $?; }
  local hosts h n a hn old width name_w addr_w user_w via_w swap wide et_ok
  local hu hv ro via via_c
  HOST_ORDER_MODE=0
  # The ET label follows the same rule as the real transport, so check once whether et
  # is installed.
  if command -v et >/dev/null 2>&1; then et_ok=1; else et_ok=0; fi
  while true; do
    hosts=()
    while IFS= read -r h; do [ -n "$h" ] && hosts+=("$h"); done < <(list_host_aliases)
    n=${#hosts[@]}

    # With no hosts registered, go straight to adding one
    if [ "$n" -eq 0 ]; then
      if add_host; then clear_screen; continue; else return 1; fi
    fi

    width=$(dash_inner_width)
    set_box_width "$width"
    # A wide window spreads out the USER and VIA columns; a narrow one folds them back
    # into a single user@host cell.
    if [ "$width" -ge 52 ]; then
      wide=1; name_w=12; user_w=8; via_w=11
      addr_w=$(( width - name_w - user_w - via_w - 7 )); [ "$addr_w" -lt 10 ] && addr_w=10
      printf -v HTH_PLAIN "%-${name_w}s  %-${user_w}s  %-${addr_w}s  %s" 'HOST' 'USER' 'ADDRESS' 'VIA'
    else
      wide=0; name_w=12; [ "$width" -lt 34 ] && name_w=9
      addr_w=$((width - name_w - 3)); [ "$addr_w" -lt 8 ] && addr_w=8
      printf -v HTH_PLAIN "%-${name_w}s  %s" 'HOST' 'ADDRESS'
    fi
    HN=$n
    HROW_PLAIN=(); HREND=(); HROW_ACTION=(); FILTER_ITEMS=(); HOST_ACTION_COUNT=0
    for h in "${hosts[@]}"; do
      if resolve_host_fields "$h"; then
        a="$RESOLVED_HOST"
        [ -n "$RESOLVED_PORT" ] && [ "$RESOLVED_PORT" != 22 ] && a="$a:$RESOLVED_PORT"
      else
        a="?"; RESOLVED_USER=""; RESOLVED_PORT=""
      fi
      # VIA mirrors connection_transport, so it shows the transport actually used.
      via='SSH'; via_c="$DIM"
      if [ "$et_ok" -eq 1 ]; then
        if load_host_et_port "$h"; then via="ET $RESOLVED_ET_PORT"; via_c="$YE"
        elif host_has_explicit_port "$h"; then :
        elif [ -n "$RESOLVED_PORT" ] && [ "$RESOLVED_PORT" != 22 ]; then :
        else via='ET'; via_c="$YE"
        fi
      fi
      # Hosts outside the ezet config cannot be edited or deleted here (read-only).
      if host_in_file "$h" "$EZET_HOSTS_FILE"; then ro=''; else ro='ro'; fi
      printf -v hn "%-${name_w}s" "$(trunc "$h" "$name_w")"
      if [ "$wide" -eq 1 ]; then
        printf -v hu "%-${user_w}s" "$(trunc "${RESOLVED_USER:--}" "$user_w")"
        printf -v a  "%-${addr_w}s" "$(trunc "$a" "$addr_w")"
        printf -v hv "%-${via_w}s" "$(trunc "$([ -n "$ro" ] && echo "$via  $ro" || echo "$via")" "$via_w")"
        HROW_PLAIN+=("${hn}  ${hu}  ${a}  ${hv}")
        HREND+=("${CY}${B}${hn}${RCF}  ${DIM}${hu}${RCF}  ${a}  ${via_c}${hv}${RCF}")
      else
        [ -n "$RESOLVED_USER" ] && a="$RESOLVED_USER@$a"
        a="$(trunc "$a" "$addr_w")"
        HROW_PLAIN+=("${hn}  ${a}")
        HREND+=("${CY}${B}${hn}${RCF}  ${DIM}${a}${RCF}")
      fi
      FILTER_ITEMS+=("$h ${RESOLVED_USER:-} $a $via")
    done
    if [ "$HOST_ORDER_MODE" -eq 1 ]; then
      FILTER_SEARCHABLE=0
      arrow_loop draw_hosts "$n" 0 order
    else
      HROW_PLAIN+=('＋ New Host')
      HREND+=("${DIM}＋ New Host${RCF}")
      HROW_ACTION+=('new')
      FILTER_ITEMS+=('new host add')
      HOST_ACTION_COUNT=1
      FILTER_SEARCHABLE=1
      arrow_loop draw_hosts "$((n + HOST_ACTION_COUNT))" 1 edit
    fi
    case "$A_ACTION" in
      cancel) return 1 ;;
      item)
        if [ "$A_IDX" -ge "$n" ]; then
          ARROW_START=0; add_host || true; clear_screen; continue
        fi
        printf '%s\n' "${hosts[$A_IDX]}"; return 0 ;;
      new)    ARROW_START=$A_IDX; add_host || true; clear_screen; continue ;;
      order)
        HOST_ORDER_MODE=1
        ARROW_START=$A_IDX
        clear_screen
        continue ;;
      order_done)
        HOST_ORDER_MODE=0
        ARROW_START=$A_IDX
        clear_screen
        continue ;;
      move_up)
        ARROW_START=$A_IDX
        if [ "$A_IDX" -gt 0 ]; then
          swap="${hosts[$((A_IDX - 1))]}"
          hosts[A_IDX - 1]="${hosts[$A_IDX]}"
          hosts[A_IDX]="$swap"
          if save_host_order "${hosts[@]}"; then ARROW_START=$((A_IDX - 1))
          else host_status err "Could not save the host order." "Tried to write: $EZET_HOST_ORDER_FILE"; fi
        fi
        clear_screen
        continue ;;
      move_down)
        ARROW_START=$A_IDX
        if [ "$A_IDX" -lt $((n - 1)) ]; then
          swap="${hosts[$((A_IDX + 1))]}"
          hosts[A_IDX + 1]="${hosts[$A_IDX]}"
          hosts[A_IDX]="$swap"
          if save_host_order "${hosts[@]}"; then ARROW_START=$((A_IDX + 1))
          else host_status err "Could not save the host order." "Tried to write: $EZET_HOST_ORDER_FILE"; fi
        fi
        clear_screen
        continue ;;
      edit)
        ARROW_START=$A_IDX
        old="${hosts[$A_IDX]}"
        if host_in_file "$old" "$EZET_HOSTS_FILE"; then edit_host "$old" || true
        else read_only_status "$old" edit; fi
        clear_screen
        continue ;;
      delete)
        ARROW_START=$A_IDX
        old="${hosts[$A_IDX]}"
        if host_in_file "$old" "$EZET_HOSTS_FILE"; then
          if delete_host "$old" && [ "$n" -eq 1 ]; then return 1; fi
        else
          read_only_status "$old" delete
        fi
        clear_screen
        continue ;;
    esac
  done
}

# Non-terminal fallback (a pipe, say): read the name as text.
pick_host_text() {
  local hosts h n choice width name_w addr_w a hn
  hosts=()
  while IFS= read -r h; do [ -n "$h" ] && hosts+=("$h"); done < <(list_host_aliases)
  n=${#hosts[@]}
  if [ "$n" -eq 0 ]; then
    printf '\n  No Host in the ezet config. Enter a host name (Enter=cancel): ' >&2
    read -r choice || { printf '\n' >&2; return 1; }
    [ -z "$choice" ] && return 1
    printf '%s\n' "$choice"; return 0
  fi
  width=$(dash_inner_width)
  set_box_width "$width"
  name_w=12; [ "$width" -lt 34 ] && name_w=9
  addr_w=$((width - name_w - 3)); [ "$addr_w" -lt 8 ] && addr_w=8
  {
    echo; box_top
    box_line_wide "SSH HOSTS ($n)" "${B}SSH HOSTS ($n)${RESET}"; box_mid
    for h in "${hosts[@]}"; do
      a="$(resolve_address "$h" || true)"; [ -z "$a" ] && a="?"; a="$(trunc "$a" "$addr_w")"
      printf -v hn "%-${name_w}s" "$(trunc "$h" "$name_w")"
      box_line_wide "${hn}  ${a}" "${CY}${B}${hn}${RESET}  ${DIM}${a}${RESET}"
    done
    box_bot; echo
    printf '  Pick a host name (Enter=%s): ' "$([ "$n" -eq 1 ] && echo "${hosts[0]}" || echo cancel)"
  } >&2
  read -r choice || { printf '\n' >&2; return 1; }
  if [ -z "$choice" ]; then
    [ "$n" -eq 1 ] && { printf '%s\n' "${hosts[0]}"; return 0; }
    return 1
  fi
  printf '%s\n' "$choice"
}

# ── Session query and display ────────────────────────────────────
# Globals: now names[] wins[] atts[] acts[] cmds[] paths[] count,
#          FETCH_ERROR/FETCH_HINT/REMOTE_TMUX
# FETCH_ERROR: the short reason shown inside the table.
# FETCH_HINT: what to do about it, shown under the table.
FETCH_ERROR=""; FETCH_HINT=""; REMOTE_TMUX=""
fetch_sessions() {
  local list_raw line payload rest name windows attached activity created cmd path tmux_path
  local connected=0 no_tmux=0 tmux_exec_failed=0 bad_tmux_path=0
  FETCH_ERROR=""; FETCH_HINT=""; REMOTE_TMUX=""
  # -n keeps ssh from consuming local stdin, which would eat the session keystrokes.
  if ! list_raw=$(ssh -n "${SSH_CONNECT_OPTIONS[@]}" "$host" '
    valid_tmux_path() {
      case "$1" in /*) ;; *) return 1 ;; esac
      case "$1" in *[!A-Za-z0-9_./+-]*) return 1 ;; esac
      [ -f "$1" ] && [ -x "$1" ]
    }
    find_tmux() {
      local candidate login_shell
      candidate=$(command -v tmux 2>/dev/null || true)
      if valid_tmux_path "$candidate"; then printf "%s\n" "$candidate"; return 0; fi

      for candidate in \
        /usr/bin/tmux /usr/local/bin/tmux /opt/local/bin/tmux /opt/homebrew/bin/tmux \
        /home/linuxbrew/.linuxbrew/bin/tmux "$HOME/.local/bin/tmux" \
        "$HOME/.nix-profile/bin/tmux" /run/current-system/sw/bin/tmux /snap/bin/tmux
      do
        if valid_tmux_path "$candidate"; then printf "%s\n" "$candidate"; return 0; fi
      done

      login_shell="${SHELL:-/bin/sh}"
      case "$login_shell" in /*) ;; *) login_shell=/bin/sh ;; esac
      [ -f "$login_shell" ] && [ -x "$login_shell" ] || login_shell=/bin/sh
      candidate=$("$login_shell" -lc "command -v tmux" 2>/dev/null | sed -n "/^\//{p;q;}")
      if valid_tmux_path "$candidate"; then printf "%s\n" "$candidate"; return 0; fi
      candidate=$("$login_shell" -ic "command -v tmux" 2>/dev/null | sed -n "/^\//{p;q;}")
      if valid_tmux_path "$candidate"; then printf "%s\n" "$candidate"; return 0; fi
      return 1
    }

    printf "__DT_CONNECTED__\n"
    tmux_bin=$(find_tmux || true)
    if [ -z "$tmux_bin" ]; then
      printf "__DT_NO_TMUX__\n"
      exit 0
    fi
    if ! "$tmux_bin" -V >/dev/null 2>&1; then
      printf "__DT_TMUX_EXEC_FAILED__\n"
      exit 0
    fi
    printf "__DT_TMUX__=%s\n" "$tmux_bin"
    printf "__DT_NOW__=%s\n" "$(date +%s)"
    "$tmux_bin" list-sessions -F "__DT_SESSION__|#{session_name}|#{session_windows}|#{?session_attached,attached,}|#{session_activity}|#{session_created}|#{pane_current_command}|#{pane_current_path}" 2>/dev/null || true
  ' 2>&1); then
    # SSH itself failed. The underlying cause comes from the ssh diagnostic (its
    # wording is fixed English).
    case "$list_raw" in
      *"Operation timed out"*|*"Connection timed out"*|*"timed out"*)
        FETCH_ERROR="connection failed · no response"
        FETCH_HINT="No response within the timeout. Check that the host is up, and your network/VPN." ;;
      *"Connection refused"*)
        FETCH_ERROR="connection failed · refused"
        FETCH_HINT="The remote refused the connection. Check that sshd is running, and the port." ;;
      *"Permission denied"*|*"Too many authentication failures"*)
        FETCH_ERROR="connection failed · auth"
        FETCH_HINT="Authentication failed. Check the user name and your SSH key." ;;
      *"Could not resolve"*|*"Name or service not known"*|*"nodename nor servname"*)
        FETCH_ERROR="connection failed · address"
        FETCH_HINT="Host address could not be resolved. Check HostName (edit with e)." ;;
      *"Host key verification failed"*)
        FETCH_ERROR="connection failed · host key"
        FETCH_HINT="Host key verification failed. Check your known_hosts entry." ;;
      *)
        FETCH_ERROR="connection failed"
        FETCH_HINT="Cannot connect over SSH. Check the address, port and key." ;;
    esac
    now=0; names=(); wins=(); atts=(); acts=(); crts=(); cmds=(); paths=(); count=0
    return 1
  fi
  now=0
  names=(); wins=(); atts=(); acts=(); crts=(); cmds=(); paths=()
  if [ -n "$list_raw" ]; then
    while IFS= read -r line; do
      case "$line" in
        __DT_CONNECTED__) connected=1 ;;
        __DT_NO_TMUX__) no_tmux=1 ;;
        __DT_TMUX_EXEC_FAILED__) tmux_exec_failed=1 ;;
        __DT_TMUX__=*)
          tmux_path="${line#__DT_TMUX__=}"
          if valid_remote_tmux_path "$tmux_path"; then REMOTE_TMUX="$tmux_path"
          else bad_tmux_path=1
          fi ;;
        __DT_NOW__=*)
          now="${line#__DT_NOW__=}"
          # Remote values end up in arithmetic, so only digits are accepted (same for the
          # session fields below), and the length is capped: beyond 64 bits, test and
          # arithmetic throw errors that wreck the screen.
          case "$now" in ''|*[!0-9]*) now=0 ;; esac
          [ "${#now}" -gt 12 ] && now=0 ;;
        "__DT_SESSION__|"*)
          payload="${line#__DT_SESSION__|}"
          # A session name may contain '|', so splitting from the front would shift the
          # fields. Peel the six fixed fields off the end and treat the rest as the name.
          case "$payload" in *'|'*'|'*'|'*'|'*'|'*'|'*) ;; *) continue ;; esac
          rest="$payload"
          path="${rest##*|}";     rest="${rest%|*}"
          cmd="${rest##*|}";      rest="${rest%|*}"
          created="${rest##*|}";  rest="${rest%|*}"
          activity="${rest##*|}"; rest="${rest%|*}"
          attached="${rest##*|}"; rest="${rest%|*}"
          windows="${rest##*|}";  rest="${rest%|*}"
          name="$rest"
          [ -z "$name" ] && continue
          # Validate the numeric fields: unchecked, $(( )) would let the remote run a
          # local command.
          case "$windows"  in ''|*[!0-9]*) windows=0 ;; esac
          case "$activity" in ''|*[!0-9]*) activity=0 ;; esac
          case "$created"  in ''|*[!0-9]*) created=0 ;; esac
          [ "${#windows}"  -gt 6  ] && windows=0
          [ "${#activity}" -gt 12 ] && activity=0
          [ "${#created}"  -gt 12 ] && created=0
          [ "$attached" = attached ] || attached=""
          # Strip control characters (ANSI escapes and friends) from display strings so
          # the remote cannot drive the screen.
          name="${name//[[:cntrl:]]/}"; cmd="${cmd//[[:cntrl:]]/}"; path="${path//[[:cntrl:]]/}"
          names+=("$name"); wins+=("$windows"); atts+=("$attached")
          acts+=("$activity"); crts+=("$created"); cmds+=("$cmd"); paths+=("$path") ;;
      esac
    done <<< "$list_raw"
  fi
  count=${#names[@]}
  if [ "$connected" -ne 1 ]; then
    # SSH succeeded but the POSIX script marker never arrived = the remote shell is not
    # POSIX. (Windows cmd runs only the first of several lines, and its error text is
    # localised, so this behaviour difference is the test rather than a string match.)
    FETCH_ERROR="non-POSIX shell (e.g. Windows)"
    FETCH_HINT="tmux sessions are unavailable. You can connect with the SSH row below."
    return 1
  fi
  if [ "$no_tmux" -eq 1 ]; then
    FETCH_ERROR="no tmux on the remote"
    FETCH_HINT="Install tmux on the remote and retry, or connect with the SSH row below."
    return 1
  fi
  if [ "$tmux_exec_failed" -eq 1 ]; then
    FETCH_ERROR="tmux failed to run"
    FETCH_HINT="tmux was found but would not run. Check tmux -V on the remote."
    return 1
  fi
  if [ "$bad_tmux_path" -eq 1 ] || [ -z "$REMOTE_TMUX" ]; then
    FETCH_ERROR="tmux path unverified"
    FETCH_HINT="Check the remote tmux path, or connect with the SSH row below."
    return 1
  fi
  return 0
}

# Globals: DIR_W TH_PLAIN ROW_PLAIN[] ROW_REND[] (+ set_box_width)
SSH_FALLBACK_PLAIN="SSH Direct  connect without tmux"
SSH_FALLBACK_REND="${YE}${B}SSH Direct${RCF}  ${DIM}connect without tmux${RESET}"
ROW_ACTION=(); SESSION_ACTION_COUNT=0
build_session_rows() {
  local PREFIX_W cols max_inner name_w show_age
  local k st sc idle_s ic age_s c_n c_w c_s c_e c_a c_c c_d
  local dirs=()
  cols=$(term_cols)
  max_inner=$(dash_inner_width)
  ROW_PLAIN=(); ROW_REND=(); ROW_ACTION=(); SESSION_ACTION_COUNT=0
  # PREFIX_W = total width of the columns before DIR. AGE (time since creation) squeezes
  # DIR down to 8 cells, so it only unfolds on a wide window (>=88) that can still leave
  # DIR 16 cells.
  if [ "$cols" -ge 88 ]; then show_age=1; PREFIX_W=67; else show_age=0; PREFIX_W=59; fi

  if [ "$cols" -ge 72 ]; then
    # The box width is fixed by the screen; the leftover space goes to the last column.
    DIR_W=$(( max_inner - PREFIX_W - 1 )); [ "$DIR_W" -lt 8 ] && DIR_W=8
    set_box_width "$(( PREFIX_W + DIR_W + 1 ))"
    # DIR shows the path with home shortened to ~, not just the last component.
    k=0
    while [ "$k" -lt "$count" ]; do
      dirs[k]=$(fmt_dir "${paths[$k]}" "$DIR_W")
      k=$((k + 1))
    done
    if [ "$show_age" -eq 1 ]; then
      TH_PLAIN=$(printf "%-19s  %-4s  %-8s  %-6s  %-6s  %-12s  %s" \
                 "TMUX ($count)" 'WIN' 'STATUS' 'IDLE' 'AGE' 'CMD' 'DIR')
    else
      TH_PLAIN=$(printf "%-19s  %-4s  %-8s  %-6s  %-12s  %s" \
                 "TMUX ($count)" 'WIN' 'STATUS' 'IDLE' 'CMD' 'DIR')
    fi
  else
    # A narrow window keeps only the essentials, so nothing scrolls sideways.
    set_box_width "$max_inner"
    name_w=$((max_inner - 14)); [ "$name_w" -lt 6 ] && name_w=6
    TH_PLAIN=$(printf "%-${name_w}s  %-3s  %-6s" "$(trunc "TMUX ($count)" "$name_w")" 'ST' 'IDLE')
  fi

  k=0
  while [ "$k" -lt "$count" ]; do
    if [ -n "${atts[$k]}" ]; then st='attached'; sc="$GR"; else st='detached'; sc="$DIM"; fi
    # acts[] passed the numeric check while parsing (0 = missing/bogus, idle unknown).
    if [ "$now" -gt 0 ] && [ "${acts[$k]}" -gt 0 ]; then idle_s=$(( now - ${acts[$k]} )); else idle_s=-1; fi
    # crts[] likewise (0 = missing, age unknown).
    if [ "$now" -gt 0 ] && [ "${crts[$k]}" -gt 0 ]; then age_s=$(( now - ${crts[$k]} )); else age_s=-1; fi
    if   [ "$idle_s" -lt 0 ];     then ic="$DIM"
    elif [ "$idle_s" -lt 3600 ];  then ic="$GR"
    elif [ "$idle_s" -lt 86400 ]; then ic="$YE"
    else                               ic="$RED"
    fi
    if [ "$cols" -ge 72 ]; then
      printf -v c_n '%-19s'  "$(trunc "${names[$k]}" 19)"
      printf -v c_w '%-4s'   "${wins[$k]}w"
      printf -v c_s '%-8s'   "$st"
      printf -v c_e '%-6s'   "$(fmt_idle "$idle_s")"
      printf -v c_c '%-12s'  "$(trunc "${cmds[$k]}" 12)"
      printf -v c_d "%-${DIR_W}s"  "${dirs[$k]}"
      if [ "$show_age" -eq 1 ]; then
        printf -v c_a '%-6s' "$(fmt_idle "$age_s")"
        ROW_PLAIN+=("${c_n}  ${c_w}  ${c_s}  ${c_e}  ${c_a}  ${c_c}  ${c_d}")
        ROW_REND+=("${CY}${B}${c_n}${RCF}  ${DIM}${c_w}${RCF}  ${sc}${c_s}${RCF}  ${ic}${c_e}${RCF}  ${DIM}${c_a}${RCF}  ${YE}${c_c}${RCF}  ${DIM}${c_d}${RCF}")
      else
        ROW_PLAIN+=("${c_n}  ${c_w}  ${c_s}  ${c_e}  ${c_c}  ${c_d}")
        ROW_REND+=("${CY}${B}${c_n}${RCF}  ${DIM}${c_w}${RCF}  ${sc}${c_s}${RCF}  ${ic}${c_e}${RCF}  ${YE}${c_c}${RCF}  ${DIM}${c_d}${RCF}")
      fi
    else
      printf -v c_n "%-${name_w}s" "$(trunc "${names[$k]}" "$name_w")"
      printf -v c_s '%-3s' "$([ -n "${atts[$k]}" ] && echo on || echo -)"
      printf -v c_e '%-6s' "$(fmt_idle "$idle_s")"
      ROW_PLAIN+=("${c_n}  ${c_s}  ${c_e}")
      ROW_REND+=("${CY}${B}${c_n}${RCF}  ${sc}${c_s}${RCF}  ${ic}${c_e}${RCF}")
    fi
    k=$((k + 1))
  done

  # Plain search text (name + command + path), used for the VIS mapping in arrow_loop.
  FILTER_ITEMS=()
  k=0
  while [ "$k" -lt "$count" ]; do
    FILTER_ITEMS+=("${names[$k]} ${cmds[$k]:-} ${paths[$k]:-}")
    k=$((k + 1))
  done
  if [ "$TMUX_AVAILABLE" -eq 0 ]; then
    FILTER_ITEMS=("ssh shell remote")
    FILTER_SEARCHABLE=0
  else
    # `＋ New Session` is appended in grey as the last row of the tmux list; only
    # `SSH Direct`, below the separator, gets the yellow accent.
    ROW_PLAIN+=('＋ New Session')
    ROW_REND+=("${DIM}＋ New Session${RCF}")
    ROW_ACTION[count]='new'
    FILTER_ITEMS+=('new session add')
    ROW_PLAIN+=('SSH Direct')
    ROW_REND+=("${YE}${B}SSH Direct${RCF}")
    ROW_ACTION[count + 1]='ssh'
    FILTER_ITEMS+=('ssh shell direct')
    SESSION_ACTION_COUNT=2
    FILTER_SEARCHABLE=1
  fi
}

# Session name form (new session · rename). One field only, so there is no step count.
draw_session_form() {             # $1=new|rename  $2=current name (rename)
  local mode="$1" old="${2:-}" width title trend label hint
  width=$(dash_inner_width); set_box_width "$width"
  if [ "$mode" = rename ]; then
    title="RENAME SESSION  $old"; trend="${B}RENAME SESSION${RESET}  ${CY}${B}${old}${RESET}"
    label='NEW NAME'; hint="new name for $old"
  else
    title="NEW SESSION  $host"; trend="${B}NEW SESSION${RESET}  ${CY}${B}${host}${RESET}"
    label='NAME'; hint='tmux session to create'
  fi
  is_tty && clear_screen
  {
    app_header "$([ "$mode" = rename ] && echo 'RENAME SESSION' || echo 'NEW SESSION')"
    box_top
    box_line_wide "$title" "$trend"
    box_mid
    [ "$mode" = rename ] && af_row none x 'CURRENT' "$old" '-'
    af_row name name "$label" '' "$hint"
    box_mid
    af_note 'Letters, digits and . _ - only'
    af_note 'Enter = cancel'
    box_bot
    echo
    [ -n "$AF_ERROR" ] && printf '  %s✗ %s%s\n\n' "$RED" "$AF_ERROR" "$RESET"
    printf '  %s%-7s%s %s▸%s ' "$B" "$label" "$RESET" "$YE" "$RESET"
  } >&2
}

# Draw the session dashboard.
TMUX_AVAILABLE=0
draw_sessions() {
  local value_w=$((INNER_W - 7)) info pos orig rows=0 hint_rows=0 search_rows=0 status_rows=0 action_started=0
  [ "$value_w" -lt 8 ] && value_w=8
  {
    app_header 'TMUX SESSIONS'
    box_corner_hint "← back"
    box_top
    row_kv 'HOST' "$(trunc "$host" "$value_w")" "${CY}${B}"
    row_kv 'ADDR' "$(trunc "$addr" "$value_w")" "$B"
    row_kv 'VIA'  "$(trunc "$via" "$value_w")" "$YE"
    box_mid
    if [ "$FILTER_SEARCHABLE" -eq 1 ]; then
      draw_search_row "session name, command or path"
      search_rows=2
    fi
    box_line_wide "$TH_PLAIN" "${DIM}${TH_PLAIN}${RESET}"
    if [ "$count" -eq 0 ]; then
      if [ "$TMUX_AVAILABLE" -eq 1 ]; then
        info="no active tmux sessions"
        box_line_wide "$info" "${DIM}${info}${RESET}"
      else
        # Draw by display width: counting characters would push the right border out.
        info="tmux unavailable · ${FETCH_ERROR:-unknown error}"
        while [ "$(disp_width "$info")" -gt "$((INNER_W - 1))" ]; do info="${info%?}"; done
        box_line_wide "$info" "${RED}${info}${RESET}"
      fi
      rows=$((rows + 1))
      if [ "$TMUX_AVAILABLE" -eq 0 ]; then
        box_mid
        box_line_wide_sel "$SSH_FALLBACK_PLAIN" "$SSH_FALLBACK_REND"
        rows=$((rows + 2))
      fi
    fi
    if [ "$count" -gt 0 ] && [ "${#VIS[@]}" -eq 0 ]; then
      box_line_wide "no matches" "${DIM}no matches${RESET}"
      rows=$((rows + 1))
    fi
    if [ "$TMUX_AVAILABLE" -eq 1 ]; then
      for pos in "${!VIS[@]}"; do
        orig="${VIS[$pos]}"
        # `＋ New Session` (index=count) stays attached to the list; the separator goes
        # only before `SSH Direct` (index=count+1) underneath it.
        if [ "$orig" -gt "$count" ] && [ "$action_started" -eq 0 ]; then
          box_mid; rows=$((rows + 1)); action_started=1
        fi
        if [ "$FILTER_ON" -eq 0 ] && [ "$pos" -eq "$CUR" ]; then box_line_wide_sel "${ROW_PLAIN[$orig]}" "${ROW_REND[$orig]}"
        else box_line_wide "${ROW_PLAIN[$orig]}" "${ROW_REND[$orig]}"; fi
        rows=$((rows + 1))
      done
    fi
    box_bot
    echo
    # Per-reason guidance (outside the box, so no width limit)
    if [ "$TMUX_AVAILABLE" -eq 0 ] && [ -n "$FETCH_HINT" ] && [ "$FILTER_ON" -eq 0 ]; then
      printf '  %s%s%s\n\n' "$DIM" "$FETCH_HINT" "$RESET"
      hint_rows=2
    fi
    if [ "$TMUX_AVAILABLE" -eq 0 ]; then
      printf '  %sq%s quit\n' "$B" "$RESET"
    elif [ "$count" -eq 0 ]; then
      printf '  %sq%s quit\n' "$B" "$RESET"
    else
      printf '  %se%s edit · %sq%s quit\n' \
        "$B" "$RESET" "$B" "$RESET"
    fi
    draw_status_line "$SESSION_STATUS_KIND" "$SESSION_STATUS" ''; status_rows=$STATUS_ROWS
  } >&2
  DREW_LINES=$(( 8 + rows + 3 + hint_rows + search_rows + status_rows ))
}

refresh_sessions() {
  local label="${1:-tmux sessions}"
  # On the interactive screen, status and the new table are not appended below the
  # previous list: the loading screen and the finished dashboard each replace the same
  # terminal screen.
  if is_tty; then clear_screen; fi
  if is_tty; then
    show_ssh_auth_wait "$host"
  else
    activity_start "Fetching $label" "$host · up to ${EZET_SSH_CONNECT_TIMEOUT}s"
  fi
  if fetch_sessions; then
    TMUX_AVAILABLE=1
    via="$VIA_BASE"
    activity_stop success "Fetched $label" "${count} session(s)"
  else
    TMUX_AVAILABLE=0
    # With tmux unusable, a VIA of Eternal Terminal would suggest sessions are reachable.
    via="SSH (tmux unavailable)"
    activity_stop warning "Cannot fetch $label" "${FETCH_ERROR:-unknown error}"
  fi
  build_session_rows
  if is_tty; then clear_screen; fi
}

# ── Main ─────────────────────────────────────────────────────────
trap 'stop_activity_silent; dashboard_stop; sanitize_terminal; show_cursor' EXIT
trap 'exit 130' INT
trap 'exit 129' HUP
trap 'exit 143' TERM

setup_multiplexing

if ! config_ensure; then
  echo "ezet: could not prepare the ezet SSH config." >&2
  exit 1
fi

# A quick connect with an explicit session name behaves like an ordinary CLI; only a
# run that needs to pick a host or session opens the separate TUI screen.
if [ "$#" -lt 2 ]; then dashboard_start; fi

if [ "$#" -eq 0 ]; then
  host="$(pick_host)" || { echo "Cancelled." >&2; exit 0; }
  [ -z "$host" ] && { echo "Cancelled." >&2; exit 0; }
else
  host="$1"
fi

valid_name "$host" || { echo "ezet: invalid host name (letters/digits/._- only): $host" >&2; exit 2; }

# Two arguments: an explicit session name connects straight away and exits
if [ "$#" -eq 2 ]; then
  connect_status=0
  connect_session "$2" || connect_status=$?
  exit "$connect_status"
fi

addr=$(resolve_address) || addr="(unresolved)"
if [ "$(connection_transport "$host")" = et ]; then VIA_BASE="Eternal Terminal"; else VIA_BASE="SSH"; fi
via="$VIA_BASE"

refresh_sessions 'tmux sessions'

target=""
if is_tty; then
  while true; do
    target=""; action=""; chooser_count="$count"; chooser_mode=session
    if [ "$TMUX_AVAILABLE" -eq 0 ]; then chooser_count=1; chooser_mode=fallback
    else chooser_count=$((count + SESSION_ACTION_COUNT)); fi
    arrow_loop draw_sessions "$chooser_count" "$TMUX_AVAILABLE" "$chooser_mode"
    if [ "$A_ACTION" = item ] && [ "$TMUX_AVAILABLE" -eq 1 ] && [ "$A_IDX" -ge "$count" ]; then
      case "${ROW_ACTION[$A_IDX]:-}" in
        new) A_ACTION=new ;;
        ssh) action=ssh ;;
      esac
    fi
    case "$A_ACTION" in
      cancel) echo "Cancelled." >&2; exit 0 ;;
      back)   dashboard_stop; exec "$0" ;;
      item)
        if [ "$TMUX_AVAILABLE" -eq 0 ]; then action=ssh
        elif [ "$action" != ssh ]; then target="${names[$A_IDX]}"
        fi ;;
      new)
        session_status_clear; AF_ERROR=''
        while true; do
          draw_session_form new
          read -r target || target=""
          [ -z "$target" ] && break
          if valid_name "$target"; then break; fi
          AF_ERROR='Invalid name (letters/digits/._- only).'
        done
        if [ -z "$target" ]; then ARROW_START=$A_IDX; clear_screen; continue; fi ;;
      edit)
        ARROW_START=$A_IDX
        session_status_clear; AF_ERROR=''
        old="${names[$A_IDX]}"
        if ! valid_name "$old"; then
          session_status err "This session name cannot be safely renamed in ezet: $old"
          continue
        fi
        draw_session_form rename "$old"
        read -r nn || { echo >&2; continue; }
        if [ -z "$nn" ]; then clear_screen; continue; fi
        if valid_name "$nn"; then
          rename_ok=0
          tmux_bin="${REMOTE_TMUX:-}"
          if ! valid_remote_tmux_path "$tmux_bin"; then
            session_status err 'Rename failed (remote tmux path unverified).'
          elif ssh -n "${SSH_CONNECT_OPTIONS[@]}" "$host" "'$tmux_bin' rename-session -t '$old' '$nn'" 2>/dev/null; then
            session_status ok "Renamed: $old -> $nn"
            rename_ok=1
          else
            session_status err 'Rename failed (duplicate name?).'
          fi
          if [ "$rename_ok" -eq 1 ]; then refresh_sessions 'the session list'; fi
          clear_screen
        else
          session_status err 'Invalid name (letters/digits/._- only).'
        fi
        continue ;;
    esac

    # Refresh the session screen after a tmux attach/detach ends.
    connect_status=0
    keep_idx=$A_IDX
    if [ "$action" = ssh ]; then
      dashboard_suspend
      connect_plain_ssh || connect_status=$?
      sanitize_terminal
      if [ "$connect_status" -eq 255 ]; then
        dashboard_resume
        clear_screen
        ARROW_START=$keep_idx
        echo "[$host] connection failed (status 255). Press Enter to retry." >&2
        continue
      fi
      exit "$connect_status"
    fi

    dashboard_suspend
    connect_session "$target" || connect_status=$?
    sanitize_terminal
    dashboard_resume
    clear_screen
    ARROW_START=$keep_idx
    if [ "$connect_status" -ne 0 ]; then
      echo "[$host] connection failed (status $connect_status). Press Enter to retry." >&2
      continue
    fi
    refresh_sessions 'the session list'
  done
else
  # Non-terminal: plain text entry of the name
  value_w=$((INNER_W - 7)); [ "$value_w" -lt 8 ] && value_w=8
  echo
  box_top
  row_kv 'HOST' "$(trunc "$host" "$value_w")" "${CY}${B}"
  row_kv 'ADDR' "$(trunc "$addr" "$value_w")" "$B"
  row_kv 'VIA'  "$(trunc "$via" "$value_w")" "$YE"
  box_mid
  box_line_wide "$TH_PLAIN" "${DIM}${TH_PLAIN}${RESET}"
  if [ "$count" -eq 0 ]; then
    if [ "$TMUX_AVAILABLE" -eq 1 ]; then
      box_line_wide "no active tmux sessions" "${DIM}no active tmux sessions${RESET}"
    else
      info="tmux unavailable · ${FETCH_ERROR:-unknown error}"
      while [ "$(disp_width "$info")" -gt "$INNER_W" ]; do info="${info%?}"; done
      box_line_wide "$info" "${RED}${info}${RESET}"
    fi
  else
    i=0
    while [ "$i" -lt "$count" ]; do box_line_wide "${ROW_PLAIN[$i]}" "${ROW_REND[$i]}"; i=$((i + 1)); done
  fi
  box_bot
  echo
  if [ "$TMUX_AVAILABLE" -eq 0 ] && [ -n "$FETCH_HINT" ]; then
    printf '  %s\n\n' "$FETCH_HINT"
  fi
  if [ "$TMUX_AVAILABLE" -eq 0 ]; then
    printf '  Press Enter to quit: '
  elif [ "$count" -eq 0 ]; then
    printf '  New session name (Enter=cancel): '
  else
    printf '  Session name (existing or new · Enter=cancel): '
  fi
  read -r choice || { echo; exit 0; }
  [ -z "$choice" ] && { echo "Cancelled." >&2; exit 0; }
  if [ "$TMUX_AVAILABLE" -eq 0 ]; then
    echo "tmux is unavailable." >&2
    exit 1
  fi
  target="$choice"
fi

connect_session "$target"
